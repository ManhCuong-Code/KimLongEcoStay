<Router AppAssembly="typeof(Program).Assembly"
        AdditionalAssemblies="new[]
                                {
                                    typeof(KimLongEcoStay.Web.CustomerPortal.Pages.ViewProductComponent).Assembly,
                                    typeof(KimLongEcoStay.Web.AdminPortal.Controls.OutstandingOrdersComponent).Assembly
                                }">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <div class="container p-5 text-center">
                    <div class="alert alert-warning shadow-sm border border-warning">
                        <h4 class="alert-heading text-dark fw-bold"><i class="bi bi-shield-lock-fill me-2 text-danger"></i>Khu Vực Quản Trị Hệ Thống Dành Riêng Cho Nhân Viên</h4>
                        <p class="mb-2">Khách hàng có thể tự do xem danh sách buồng phòng và đặt phòng trực tuyến <strong>mà không cần đăng nhập</strong>.</p>
                        <p class="text-muted small">Để truy cập phân hệ kiểm tra đơn đặt phòng và buồng phòng, <strong>Nhân viên</strong> hoặc <strong>Quản trị viên</strong> cần phải đăng nhập tài khoản hệ thống.</p>
                        <hr />
                        <div class="d-flex justify-content-center gap-2">
                            <a href="login" class="btn btn-primary fw-bold px-4"><i class="bi bi-shield-lock me-1"></i>Đăng Nhập Nhân Viên</a>
                            <a href="/" class="btn btn-outline-success px-4"><i class="bi bi-house-door me-1"></i>Về Trang Đặt Phòng (Khách)</a>
                        </div>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <p role="alert">Trang bạn tìm kiếm không tồn tại.</p>
        </LayoutView>
    </NotFound>
</Router>