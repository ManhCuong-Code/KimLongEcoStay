@using KimLongEcoStay.CoreBusiness.Models
@using KimLongEcoStay.CoreBusiness.Services

<div class="room-resort-card">
    <!-- Hình Ảnh Phòng & Badges Nổi -->
    <div class="room-img-container position-relative">
        <a href=@($"/room/{product?.ProductId}")>
            <img src="@currentImg" alt="@product?.Name" onerror="this.src='/images/room_econest.jpg'" style="transition: opacity 0.25s ease;" />
        </a>
        
        <span class="room-floating-tag">
            <i class="bi bi-geo-alt-fill me-1"></i>@product?.Brand
        </span>
        
        <span class="room-floating-iot">
            <i class="bi bi-key-fill text-warning"></i>SmartLock 10s
        </span>

        <!-- Badge Số Lượng Góc Chụp Thực Tế -->
        <span class="position-absolute text-white badge bg-dark bg-opacity-75 rounded-pill px-2 py-1 shadow-sm" style="bottom: 10px; right: 10px; font-size: 10.5px; z-index: 2; border: 1px solid rgba(255, 255, 255, 0.2);">
            <i class="bi bi-camera-fill text-warning me-1"></i>@(photos.Count) góc chụp
        </span>
    </div>

    <!-- Thanh Xem Nhanh Các Góc Chụp (Quick Photo Previewer) -->
    @if (photos.Count > 1)
    {
        <div class="d-flex gap-1 px-3 pt-2 pb-1 bg-light border-bottom align-items-center" style="overflow-x: auto;">
            <small class="text-muted fw-bold me-1" style="font-size: 10px; text-transform: uppercase;">Góc:</small>
            @foreach (var p in photos)
            {
                var targetUrl = p.Url;
                <button type="button" 
                        class="btn btn-sm p-0 border rounded-1 overflow-hidden @(currentImg == targetUrl ? "border-warning shadow-sm" : "border-secondary")" 
                        style="width: 38px; height: 26px; flex-shrink: 0;"
                        @onclick="() => SetPreview(targetUrl)"
                        title="@p.Tag: @p.Caption">
                    <img src="@p.Url" alt="@p.Tag" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/room_econest.jpg'" />
                </button>
            }
        </div>
    }

    <!-- Nội Dung Thẻ Buồng Phòng -->
    <div class="room-body">
        <span class="room-garden-name">
            <i class="bi bi-flower1 me-1"></i>Nhà Vườn Sinh Thái Kim Long
        </span>

        <a href=@($"/room/{product?.ProductId}") class="room-title-link">
            @product?.Name
        </a>

        <p class="room-desc" title="@product?.Description">
            @product?.Description
        </p>

        <!-- Hàng Tiện Ích Sinh Thái Nổi Bật -->
        <div class="room-features-pill-row">
            <span class="room-feature-pill">
                <i class="bi bi-shield-lock"></i>Mã PIN Zalo
            </span>
            <span class="room-feature-pill">
                <i class="bi bi-bicycle"></i>Xe đạp trợ lực
            </span>
            <span class="room-feature-pill">
                <i class="bi bi-cup-hot"></i>Trà sen Cung Đình
            </span>
            <span class="room-feature-pill">
                <i class="bi bi-tree"></i>Vườn bưởi cổ
            </span>
        </div>

        <!-- Chân Thẻ: Giá Niêm Yết & Nút Đặt -->
        <div class="room-footer-pricing">
            <div>
                <span class="room-price-val">
                    @product?.Price.ToString("N0") <small style="font-size: 13px; font-weight: normal; color: #64748B;">VNĐ/đêm</small>
                </span>
                <span class="room-deposit-sub">
                    Cọc 50%: <strong>@((product?.Price * 0.5 ?? 0).ToString("N0")) đ</strong> (VietQR)
                </span>
            </div>

            <NavLink href=@($"/room/{product?.ProductId}") class="btn-book-room shadow-sm">
                <span>Xem chi tiết</span>
                <i class="bi bi-arrow-right"></i>
            </NavLink>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Product? product { get; set; }

    private List<RoomPhoto> photos = new();
    private string currentImg = string.Empty;

    protected override void OnParametersSet()
    {
        if (product != null)
        {
            photos = RoomGalleryProvider.GetPhotosByRoomId(product.productId);
            currentImg = product.ImageLink;
        }
    }

    private void SetPreview(string url)
    {
        currentImg = url;
    }
}
