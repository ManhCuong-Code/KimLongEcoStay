    private async Task SaveEditedPayroll()
    {
        if (editingPayroll != null)
        {
            if (!IsHR && !IsAdminOrCEO)
            {
                feedbackMessage = "Lỗi phân quyền: Chỉ Nhân Sự (HR) hoặc Ban Giám Đốc mới có quyền điều chỉnh số tiền lương!";
                return;
            }

            await PayrollUseCase.UpdatePayrollAsync(editingPayroll);
            isEditModalOpen = false;
            feedbackMessage = $"Đã cập nhật bảng lương của nhân viên {editingPayroll.EmployeeName}.";
            await LoadPayrolls();
        }
    }

    private async Task ApprovePayroll(Payroll p)
    {
        if (!IsAdminOrCEO)
        {
            feedbackMessage = "Lỗi phân quyền: Chỉ bậc Quản Lý / Giám Đốc (CEO) / Admin mới có quyền phê duyệt bảng lương! Kế toán không có thẩm quyền này.";
            return;
        }

        string approverName = currentUser?.Identity?.Name ?? "Trần Thị Thu (CEO)";
        bool success = await PayrollUseCase.ApprovePayrollAsync(p.Id, approverName);
        if (success)
        {
            feedbackMessage = $"Giám Đốc (CEO) đã phê duyệt bảng lương {p.PayrollCode} ({p.EmployeeName}) thành công. Bảng lương đã chuyển cho Kế toán giải ngân.";
            await LoadPayrolls();
        }
    }

    private async Task PayPayroll(Payroll p)
    {
        if (!IsAccountant && !IsAdminOrCEO)
        {
            feedbackMessage = "Lỗi phân quyền: Chỉ Kế Toán Trưởng hoặc Ban Giám Đốc mới có quyền giải ngân chi trả lương!";
            return;
        }

        bool success = await PayrollUseCase.PayPayrollAsync(p.Id, "Chuyển khoản VietQR");
        if (success)
        {
