            await LoadPayrolls();
        }
    }

    private async Task ExportPayrollCsv()
    {
        var sb = new System.Text.StringBuilder();
        sb.Append('\uFEFF'); // UTF-8 BOM
        sb.AppendLine("STT,Mã Bảng Lương,Mã Nhân Viên,Họ và Tên,Phòng Ban,Chức Vụ,Kỳ Lương,Lương Cơ Bản,Phụ Cấp,Thưởng,Tăng Ca,Khấu Trừ,Tạm Ứng,Tổng Thu Nhập,Thực Lĩnh,Phương Thức,Trạng Thái");

        int i = 1;
        foreach (var p in payrolls)
        {
            sb.AppendLine($"{i++},\"{p.PayrollCode}\",\"{p.EmployeeCode}\",\"{p.EmployeeName}\",\"{p.DepartmentName}\",\"{p.PositionTitle}\",\"Tháng {p.Month}/{p.Year}\",{p.BaseSalary},{p.Allowance},{p.Bonus},{p.OvertimePay},{p.Deductions},{p.AdvancePayment},{p.GrossIncome},{p.NetIncome},\"{p.PaymentMethod}\",\"{p.StatusDisplay}\"");
        }

        string fileName = $"Bang_Luong_KimLongEcoStay_T{selectedMonth}_{selectedYear}.csv";
        await JSRuntime.InvokeVoidAsync("downloadFileFromText", fileName, sb.ToString(), "text/csv;charset=utf-8;");
    }
