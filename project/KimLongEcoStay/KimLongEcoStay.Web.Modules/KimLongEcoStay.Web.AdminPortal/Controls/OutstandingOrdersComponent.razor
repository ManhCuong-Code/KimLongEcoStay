@using KimLongEcoStay.CoreBusiness.Models
@inject IViewOutstandingOrdersUseCase ViewOutstandingOrdersUseCase
@inject IProcessOrderUseCase ProcessOrderUseCase
@inject AuthenticationStateProvider AuthStateProvider

<div class="card shadow-sm border-0 my-3">
    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Danh Sách Đơn Hàng Chờ Xử Lý (Outstanding Orders)</h5>
        <button class="btn btn-sm btn-outline-dark" @onclick="LoadOrders"><i class="bi bi-arrow-clockwise me-1"></i>Làm mới</button>
    </div>
    <div class="card-body">
        @if (selectedOrderId > 0)
        {
            <OrderDetailComponent OrderId="@selectedOrderId" OnClose="HandleDetailClose" />
        }

        @if (orders != null && orders.Any())
        {
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã Booking</th>
                        <th>Ngày Đặt</th>
                        <th>Khách Lưu Trú</th>
                        <th>SĐT / Khu Vực</th>
                        <th class="text-center">Số Đêm</th>
                        <th class="text-end">Tổng Tiền</th>
                        <th class="text-center">Cọc 50%</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ord in orders)
                    {
                        <tr>
                            <td class="fw-bold text-success font-monospace">
                                @(string.IsNullOrEmpty(ord.UniqueId) ? $"#{ord.OrderID}" : ord.UniqueId)
                            </td>
                            <td>@ord.DatePlaced?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold">@ord.CustomerName</td>
                            <td class="small text-muted">@ord.CustomerAddress</td>
                            <td class="text-center fw-bold">@ord.LineItemCount đêm</td>
                            <td class="text-end fw-bold text-dark">@ord.TotalPrice.ToString("N0") đ</td>
                            <td class="text-center fw-bold text-danger">@((ord.TotalPrice * 0.5).ToString("N0")) đ</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-info text-white me-1 rounded-pill" @onclick="() => ViewDetails(ord.OrderID ?? 0)" title="Xem chi tiết đặt phòng">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </button>
                                <button class="btn btn-sm btn-success rounded-pill fw-bold" @onclick="() => ProcessOrder(ord.OrderID ?? 0)" title="Duyệt tiền cọc và kích hoạt SmartLock">
                                    <i class="bi bi-key-fill"></i> Duyệt Cọc & Cấp PIN
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-success mb-0">
                <i class="bi bi-check-all me-2"></i>Tuyệt vời! Hiện tại không có đơn hàng nào đang chờ xử lý.
            </div>
        }
    </div>
</div>

@code {
    private IEnumerable<Order>? orders;
    private int selectedOrderId = 0;

    protected override void OnInitialized()
    {
        LoadOrders();
    }

    private void LoadOrders()
    {
        orders = ViewOutstandingOrdersUseCase.Execute();
    }

    private void ViewDetails(int orderId)
    {
        selectedOrderId = orderId;
    }

    private void HandleDetailClose()
    {
        selectedOrderId = 0;
    }

    private async Task ProcessOrder(int orderId)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        string adminName = authState.User.Identity?.Name ?? "admin";

        bool ok = ProcessOrderUseCase.Execute(orderId, adminName);
        if (ok)
        {
            selectedOrderId = 0;
            LoadOrders();
        }
    }
}