@inject IHRManagementUseCase HRUseCase
@inject IJSRuntime JSRuntime

<div class="employee-management-page">
    <!-- Header Thao Tác & Xuất Báo Cáo -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold text-dark mb-1 font-serif">
                <i class="bi bi-person-workspace me-2 text-success"></i>Bảng Dữ Liệu Quản Lý Nhân Viên
            </h4>
            <p class="text-muted small mb-0">
                Theo dõi chi tiết nhân sự, hợp đồng lao động, dải lương cơ bản và xuất báo cáo danh sách.
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-success rounded-pill px-3 shadow-sm" @onclick="ExportToCsv">
                <i class="bi bi-file-earmark-excel-fill me-1 text-success"></i>Xuất Excel / CSV
            </button>
            <button class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" @onclick="OpenAddModal">
                <i class="bi bi-plus-lg me-1"></i>Thêm Nhân Viên
            </button>
        </div>
    </div>

    <!-- Thanh Tìm Kiếm, Lọc & Sắp Xếp Nâng Cao -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-lg-4 col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0 bg-light" 
                               placeholder="Tìm theo Tên, Mã NV, Email, Số điện thoại..." 
                               @bind="searchTerm" @bind:event="oninput" @bind:after="ApplyFilterAndSort" />
                    </div>
                </div>

                <div class="col-lg-3 col-md-3">
                    <select class="form-select bg-light" @bind="filterDepartmentId" @bind:after="ApplyFilterAndSort">
                        <option value="0">-- Tất cả phòng ban --</option>
                        @foreach (var dept in departments)
                        {
                            <option value="@dept.Id">@dept.Name</option>
                        }
                    </select>
                </div>

                <div class="col-lg-2 col-md-3">
                    <select class="form-select bg-light" @bind="filterStatus" @bind:after="ApplyFilterAndSort">
                        <option value="">-- Trạng thái --</option>
                        <option value="Đang làm việc">Đang làm việc</option>
                        <option value="Nghỉ phép">Nghỉ phép</option>
                        <option value="Tạm nghỉ">Tạm nghỉ</option>
                        <option value="Đã nghỉ việc">Đã nghỉ việc</option>
                    </select>
                </div>

                <div class="col-lg-2 col-md-6">
                    <select class="form-select bg-light" @bind="sortBy" @bind:after="ApplyFilterAndSort">
                        <option value="name_asc">Sắp xếp: Tên A-Z</option>
                        <option value="name_desc">Sắp xếp: Tên Z-A</option>
                        <option value="code_asc">Mã nhân viên</option>
                        <option value="hire_desc">Mới vào làm nhất</option>
                        <option value="salary_desc">Lương cao nhất</option>
                    </select>
                </div>

                <div class="col-lg-1 col-md-6 text-end">
                    <button class="btn btn-outline-secondary w-100 rounded-3" title="Xóa bộ lọc" @onclick="ResetFilter">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng Dữ Liệu Chuyên Nghiệp -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #0A3D2C; color: #FFFFFF;">
                    <tr>
                        <th style="width: 50px;" class="text-center">#</th>
                        <th style="width: 50px;">Ảnh</th>
                        <th style="cursor: pointer;" @onclick='() => ToggleSort("name")'>
                            Họ và Tên 
                            @if (sortBy == "name_asc") { <i class="bi bi-arrow-up-short"></i> }
                            else if (sortBy == "name_desc") { <i class="bi bi-arrow-down-short"></i> }
                        </th>
                        <th>Mã NV</th>
                        <th>Phòng Ban & Vị Trí</th>
                        <th>Thông Tin Liên Hệ</th>
                        <th class="text-end" style="cursor: pointer;" @onclick='() => ToggleSort("salary")'>
                            Lương Cơ Bản
                            @if (sortBy == "salary_desc") { <i class="bi bi-arrow-down-short"></i> }
                        </th>
                        <th style="cursor: pointer;" @onclick='() => ToggleSort("hire")'>
                            Ngày Vào Làm
                        </th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-end" style="width: 150px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5">
                                <div class="spinner-border text-success" role="status"></div>
                                <div class="text-muted mt-2">Đang tải danh sách nhân viên...</div>
                            </td>
                        </tr>
                    }
                    else if (pagedEmployees.Count == 0)
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                <i class="bi bi-search fs-2 d-block mb-2"></i>
                                Không tìm thấy nhân viên nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int index = (currentPage - 1) * pageSize + 1;
                        @foreach (var emp in pagedEmployees)
                        {
                            <tr style="cursor: pointer;" class="@(emp.WorkStatus == "Đã nghỉ việc" ? "table-secondary text-muted" : "")">
                                <td class="text-center text-muted small">@(index++)</td>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(emp.AvatarUrl) ? "/images/logo.jpg" : emp.AvatarUrl)" 
                                         alt="@emp.FullName" 
                                         class="rounded-circle border" 
                                         style="width: 40px; height: 40px; object-fit: cover;" 
                                         onerror="this.src='/images/logo.jpg'" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark" @onclick="() => ViewDetail(emp)">
                                        @emp.FullName
                                    </div>
                                    <small class="text-muted">@emp.Gender • @emp.DateOfBirth.ToString("dd/MM/yyyy")</small>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary font-monospace border border-primary px-2">
                                        @emp.EmployeeCode
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@emp.PositionTitle</div>
                                    <small class="text-muted">@emp.DepartmentName</small>
                                </td>
                                <td>
                                    <div><i class="bi bi-telephone text-success me-1 small"></i>@emp.PhoneNumber</div>
                                    <div class="small text-muted"><i class="bi bi-envelope text-info me-1 small"></i>@emp.Email</div>
                                </td>
                                <td class="text-end">
                                    <div class="fw-bold text-success">@emp.BaseSalary.ToString("N0") đ</div>
                                    <small class="text-muted">+ PC: @emp.Allowance.ToString("N0") đ</small>
                                </td>
                                <td>
                                    <div>@emp.HireDate.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">@emp.ContractType</small>
                                </td>
                                <td class="text-center">
                                    <span class="badge @GetStatusBadge(emp.WorkStatus) px-2 py-1">
                                        @emp.WorkStatus
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-info" title="Xem hồ sơ chi tiết" @onclick="() => ViewDetail(emp)" @onclick:stopPropagation="true">
                                            <i class="bi bi-eye-fill"></i>
                                        </button>
                                        <button class="btn btn-outline-primary" title="Chỉnh sửa thông tin" @onclick="() => Edit(emp)" @onclick:stopPropagation="true">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="Xóa mềm / Nghỉ việc" @onclick="() => ConfirmDelete(emp)" @onclick:stopPropagation="true">
                                            <i class="bi bi-person-x-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân Trang (Pagination) -->
        <div class="card-footer bg-white border-top p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="text-muted small">
                Hiển thị <strong>@pagedEmployees.Count</strong> / <strong>@filteredEmployees.Count</strong> nhân viên (Tổng: @allEmployees.Count)
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-muted">Số dòng:</span>
                    <select class="form-select form-select-sm" style="width: 70px;" @bind="pageSize" @bind:after="OnPageSizeChanged">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="20">20</option>
                    </select>
                </div>

                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            int pageNum = p;
                            <li class="page-item @(pageNum == currentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages || totalPages == 0 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CHI TIẾT HỒ SƠ -->
@if (isDetailModalOpen && selectedEmployee != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(10, 61, 44, 0.65); backdrop-filter: blur(4px); z-index: 1055;">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header text-white px-4 py-3" style="background: linear-gradient(135deg, #0A3D2C 0%, #14533D 100%); border-bottom: 2px solid #D4AF37;">
                    <h5 class="modal-title fw-bold mb-0 font-serif">
                        <i class="bi bi-person-bounding-box me-2 text-warning"></i>CHI TIẾT HỒ SƠ NHÂN VIÊN
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isDetailModalOpen = false"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <div class="card border-0 rounded-3 p-4 bg-white shadow-sm">
                        <div class="d-flex align-items-center gap-4 flex-wrap pb-3 border-bottom">
                            <img src="@(string.IsNullOrEmpty(selectedEmployee.AvatarUrl) ? "/images/logo.jpg" : selectedEmployee.AvatarUrl)" 
                                 alt="@selectedEmployee.FullName" 
                                 class="rounded-circle border border-3 border-success shadow" 
                                 style="width: 80px; height: 80px; object-fit: cover;" 
                                 onerror="this.src='/images/logo.jpg'" />
                            <div>
                                <h4 class="fw-bold text-dark mb-1">@selectedEmployee.FullName</h4>
                                <div class="d-flex gap-2 align-items-center flex-wrap">
                                    <span class="badge bg-primary font-monospace">@selectedEmployee.EmployeeCode</span>
                                    <span class="badge @GetStatusBadge(selectedEmployee.WorkStatus)">@selectedEmployee.WorkStatus</span>
                                    <span class="badge bg-light text-dark border">@selectedEmployee.ContractType</span>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 pt-3">
                            <div class="col-md-6">
                                <small class="text-muted">Phòng ban:</small>
                                <div class="fw-bold text-dark">@selectedEmployee.DepartmentName</div>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted">Chức vụ / Vị trí:</small>
                                <div class="fw-bold text-dark">@selectedEmployee.PositionTitle</div>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted">Số điện thoại:</small>
                                <div class="fw-semibold text-dark"><i class="bi bi-telephone text-success me-1"></i>@selectedEmployee.PhoneNumber</div>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted">Email công việc:</small>
                                <div class="fw-semibold text-dark"><i class="bi bi-envelope text-info me-1"></i>@selectedEmployee.Email</div>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted">Ngày sinh / Giới tính:</small>
                                <div>@selectedEmployee.DateOfBirth.ToString("dd/MM/yyyy") (@selectedEmployee.Gender)</div>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted">Địa chỉ thường trú:</small>
                                <div><i class="bi bi-geo-alt text-danger me-1"></i>@selectedEmployee.Address</div>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted">Ngày vào làm:</small>
                                <div>@selectedEmployee.HireDate.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted">Thời hạn hợp đồng:</small>
                                <div>
                                    @selectedEmployee.ContractStartDate.ToString("dd/MM/yyyy") - 
                                    @(selectedEmployee.ContractEndDate.HasValue ? selectedEmployee.ContractEndDate.Value.ToString("dd/MM/yyyy") : "Vô thời hạn")
                                </div>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted">Mức lương cơ bản:</small>
                                <div class="fs-5 fw-bold text-success">@selectedEmployee.BaseSalary.ToString("N0") đ</div>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted">Phụ cấp hàng tháng:</small>
                                <div class="fs-6 fw-semibold text-dark">+ @selectedEmployee.Allowance.ToString("N0") đ</div>
                            </div>
                            <div class="col-12">
                                <small class="text-muted">Ghi chú & Đánh giá:</small>
                                <div class="p-2 bg-light rounded text-muted fst-italic">@(string.IsNullOrEmpty(selectedEmployee.Notes) ? "Không có ghi chú thêm." : selectedEmployee.Notes)</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-white px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="() => isDetailModalOpen = false">
                        Đóng
                    </button>
                    <button type="button" class="btn btn-primary rounded-pill px-4" @onclick="() => { isDetailModalOpen = false; Edit(selectedEmployee); }">
                        <i class="bi bi-pencil me-1"></i>Chỉnh Sửa
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL THÊM / SỬA NHÂN VIÊN -->
@if (isFormModalOpen && editingEmployee != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(10, 61, 44, 0.65); backdrop-filter: blur(4px); z-index: 1055;">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header text-white px-4 py-3" style="background: linear-gradient(135deg, #0A3D2C 0%, #14533D 100%); border-bottom: 2px solid #D4AF37;">
                    <h5 class="modal-title fw-bold mb-0">
                        <i class="bi @(editingEmployee.Id == 0 ? "bi-person-plus-fill" : "bi-pencil-square") me-2 text-warning"></i>
                        @(editingEmployee.Id == 0 ? "THÊM NHÂN VIÊN MỚI" : "CẬP NHẬT THÔNG TIN NHÂN VIÊN")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isFormModalOpen = false"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <EditForm Model="editingEmployee" OnValidSubmit="SaveEmployee">
                        <DataAnnotationsValidator />

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger py-2 small mb-3">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>@errorMessage
                            </div>
                        }

                        <div class="card border-0 rounded-3 p-4 bg-white shadow-sm mb-3">
                            <h6 class="fw-bold text-success border-bottom pb-2 mb-3">1. Thông Tin Định Danh & Cá Nhân</h6>
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label small fw-semibold">Mã Nhân Viên</label>
                                    <input type="text" class="form-control font-monospace" @bind="editingEmployee.EmployeeCode" placeholder="KLE-NV..." />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Họ và Tên <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" @bind="editingEmployee.FullName" required placeholder="Ví dụ: Lê Văn Phúc" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-semibold">Giới Tính</label>
                                    <select class="form-select" @bind="editingEmployee.Gender">
                                        <option value="Nam">Nam</option>
                                        <option value="Nữ">Nữ</option>
                                        <option value="Khác">Khác</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Ngày Sinh</label>
                                    <input type="date" class="form-control" @bind="editingEmployee.DateOfBirth" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Số Điện Thoại <span class="text-danger">*</span></label>
                                    <input type="tel" class="form-control" @bind="editingEmployee.PhoneNumber" required placeholder="0905..." />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Email <span class="text-danger">*</span></label>
                                    <input type="email" class="form-control" @bind="editingEmployee.Email" required placeholder="name@kimlongecostay.vn" />
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label small fw-semibold">Địa Chỉ</label>
                                    <input type="text" class="form-control" @bind="editingEmployee.Address" placeholder="Địa chỉ thường trú..." />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Link Ảnh Đại Diện</label>
                                    <input type="text" class="form-control" @bind="editingEmployee.AvatarUrl" placeholder="https://..." />
                                </div>
                            </div>
                        </div>

                        <div class="card border-0 rounded-3 p-4 bg-white shadow-sm mb-3">
                            <h6 class="fw-bold text-success border-bottom pb-2 mb-3">2. Vị Trí, Lương & Trạng Thái</h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Phòng Ban <span class="text-danger">*</span></label>
                                    <select class="form-select" @bind="editingEmployee.DepartmentId" @bind:after="OnDepartmentChanged">
                                        @foreach (var d in departments)
                                        {
                                            <option value="@d.Id">@d.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Chức Vụ <span class="text-danger">*</span></label>
                                    <select class="form-select" @bind="editingEmployee.PositionId">
                                        @foreach (var p in availablePositions)
                                        {
                                            <option value="@p.Id">@p.Title</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Loại Hợp Đồng</label>
                                    <select class="form-select" @bind="editingEmployee.ContractType">
                                        <option value="Chính thức">Chính thức</option>
                                        <option value="Thử việc">Thử việc</option>
                                        <option value="Thời vụ">Thời vụ</option>
                                        <option value="Bán thời gian">Bán thời gian</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Ngày Vào Làm</label>
                                    <input type="date" class="form-control" @bind="editingEmployee.HireDate" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Ngày Hết Hạn HĐ</label>
                                    <input type="date" class="form-control" @bind="editingEmployee.ContractEndDate" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Lương Cơ Bản (VNĐ)</label>
                                    <input type="number" step="100000" class="form-control" @bind="editingEmployee.BaseSalary" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Phụ Cấp (VNĐ)</label>
                                    <input type="number" step="100000" class="form-control" @bind="editingEmployee.Allowance" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Trạng Thái Làm Việc</label>
                                    <select class="form-select" @bind="editingEmployee.WorkStatus">
                                        <option value="Đang làm việc">Đang làm việc</option>
                                        <option value="Nghỉ phép">Nghỉ phép</option>
                                        <option value="Tạm nghỉ">Tạm nghỉ</option>
                                        <option value="Đã nghỉ việc">Đã nghỉ việc</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-semibold">Ghi Chú</label>
                                    <textarea class="form-control" rows="2" @bind="editingEmployee.Notes" placeholder="Ghi chú thêm..."></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="() => isFormModalOpen = false">
                                Hủy Bỏ
                            </button>
                            <button type="submit" class="btn btn-success rounded-pill px-5 fw-bold shadow-sm">
                                <i class="bi bi-save me-1"></i>Lưu Nhân Viên
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL CẢNH BÁO XÓA MỀM -->
@if (isDeleteModalOpen && employeeToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5); backdrop-filter: blur(2px); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow border-0 rounded-4">
                <div class="modal-header bg-danger text-white px-4 py-3">
                    <h5 class="modal-title fw-bold mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Cảnh Báo Chuyển Trạng Thái Nghỉ Việc
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isDeleteModalOpen = false"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-2">Bạn có chắc chắn muốn xóa nhân viên <strong>@employeeToDelete.FullName (@employeeToDelete.EmployeeCode)</strong>?</p>
                    <div class="alert alert-warning py-2 small mb-0">
                        <i class="bi bi-shield-check me-1"></i>Hệ thống sẽ <strong>xóa mềm</strong> (chuyển sang trạng thái <em>Đã nghỉ việc</em>) để bảo lưu toàn bộ lịch sử chi trả lương và chứng từ chi phí phục vụ quyết toán.
                    </div>
                </div>
                <div class="modal-footer px-4 py-3 bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="() => isDeleteModalOpen = false">
                        Hủy
                    </button>
                    <button type="button" class="btn btn-danger rounded-pill px-4 fw-semibold" @onclick="ExecuteDelete">
                        <i class="bi bi-check2 me-1"></i>Đồng Ý Chuyển Nghỉ Việc
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;

    private List<Employee> allEmployees = new();
    private List<Employee> filteredEmployees = new();
    private List<Employee> pagedEmployees = new();

    private List<Department> departments = new();
    private List<Position> positions = new();
    private List<Position> availablePositions = new();

    private string searchTerm = "";
    private int filterDepartmentId = 0;
    private string filterStatus = "";
    private string sortBy = "name_asc";

    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => (int)Math.Ceiling((double)filteredEmployees.Count / pageSize);

    // Modal states
    private bool isDetailModalOpen = false;
    private Employee? selectedEmployee;

    private bool isFormModalOpen = false;
    private Employee? editingEmployee;
    private string errorMessage = "";

    private bool isDeleteModalOpen = false;
    private Employee? employeeToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            departments = (await HRUseCase.GetDepartmentsAsync()).ToList();
            positions = (await HRUseCase.GetPositionsAsync()).ToList();
            allEmployees = (await HRUseCase.GetEmployeesAsync(includeDeleted: false)).ToList();
            ApplyFilterAndSort();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading employees: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilterAndSort()
    {
        var query = allEmployees.AsEnumerable();

        if (filterDepartmentId > 0)
        {
            query = query.Where(e => e.DepartmentId == filterDepartmentId);
        }

        if (!string.IsNullOrWhiteSpace(filterStatus))
        {
            query = query.Where(e => e.WorkStatus.Equals(filterStatus, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            string term = searchTerm.Trim().ToLowerInvariant();
            query = query.Where(e =>
                e.FullName.ToLowerInvariant().Contains(term) ||
                e.EmployeeCode.ToLowerInvariant().Contains(term) ||
                e.Email.ToLowerInvariant().Contains(term) ||
                e.PhoneNumber.Contains(term));
        }

        // Sắp xếp
        query = sortBy switch
        {
            "name_desc" => query.OrderByDescending(e => e.FullName),
            "code_asc" => query.OrderBy(e => e.EmployeeCode),
            "hire_desc" => query.OrderByDescending(e => e.HireDate),
            "salary_desc" => query.OrderByDescending(e => e.BaseSalary),
            "name_asc" or _ => query.OrderBy(e => e.FullName)
        };

        filteredEmployees = query.ToList();
        currentPage = 1;
        UpdatePagedEmployees();
    }

    private void UpdatePagedEmployees()
    {
        pagedEmployees = filteredEmployees
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void GoToPage(int page)
    {
        if (page < 1) page = 1;
        if (page > totalPages && totalPages > 0) page = totalPages;
        currentPage = page;
        UpdatePagedEmployees();
    }

    private void OnPageSizeChanged()
    {
        currentPage = 1;
        UpdatePagedEmployees();
    }

    private void ToggleSort(string column)
    {
        if (column == "name")
        {
            sortBy = sortBy == "name_asc" ? "name_desc" : "name_asc";
        }
        else if (column == "salary")
        {
            sortBy = sortBy == "salary_desc" ? "name_asc" : "salary_desc";
        }
        else if (column == "hire")
        {
            sortBy = sortBy == "hire_desc" ? "name_asc" : "hire_desc";
        }
        ApplyFilterAndSort();
    }

    private void ResetFilter()
    {
        searchTerm = "";
        filterDepartmentId = 0;
        filterStatus = "";
        sortBy = "name_asc";
        ApplyFilterAndSort();
    }

    private void ViewDetail(Employee emp)
    {
        selectedEmployee = emp;
        isDetailModalOpen = true;
    }

    private void OpenAddModal()
    {
        editingEmployee = new Employee
        {
            DepartmentId = departments.FirstOrDefault()?.Id ?? 1,
            HireDate = DateTime.Today,
            ContractStartDate = DateTime.Today,
            ContractEndDate = DateTime.Today.AddYears(1),
            WorkStatus = "Đang làm việc",
            BaseSalary = 7000000,
            Allowance = 800000
        };
        UpdateAvailablePositions();
        editingEmployee.PositionId = availablePositions.FirstOrDefault()?.Id ?? 1;
        errorMessage = "";
        isFormModalOpen = true;
    }

    private void Edit(Employee emp)
    {
        editingEmployee = new Employee
        {
            Id = emp.Id,
            EmployeeCode = emp.EmployeeCode,
            FullName = emp.FullName,
            AvatarUrl = emp.AvatarUrl,
            DateOfBirth = emp.DateOfBirth,
            Gender = emp.Gender,
            PhoneNumber = emp.PhoneNumber,
            Email = emp.Email,
            Address = emp.Address,
            DepartmentId = emp.DepartmentId,
            DepartmentName = emp.DepartmentName,
            PositionId = emp.PositionId,
            PositionTitle = emp.PositionTitle,
            HireDate = emp.HireDate,
            ContractType = emp.ContractType,
            ContractStartDate = emp.ContractStartDate,
            ContractEndDate = emp.ContractEndDate,
            WorkStatus = emp.WorkStatus,
            BaseSalary = emp.BaseSalary,
            Allowance = emp.Allowance,
            Notes = emp.Notes
        };
        UpdateAvailablePositions();
        errorMessage = "";
        isFormModalOpen = true;
    }

    private void OnDepartmentChanged()
    {
        UpdateAvailablePositions();
        if (editingEmployee != null && availablePositions.Count > 0)
        {
            editingEmployee.PositionId = availablePositions.First().Id;
        }
    }

    private void UpdateAvailablePositions()
    {
        if (editingEmployee != null)
        {
            availablePositions = positions.Where(p => p.DepartmentId == editingEmployee.DepartmentId).ToList();
            if (availablePositions.Count == 0) availablePositions = positions;
        }
    }

    private async Task SaveEmployee()
    {
        if (editingEmployee == null) return;
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(editingEmployee.FullName))
        {
            errorMessage = "Vui lòng nhập họ và tên nhân viên.";
            return;
        }
        if (string.IsNullOrWhiteSpace(editingEmployee.PhoneNumber))
        {
            errorMessage = "Vui lòng nhập số điện thoại liên hệ.";
            return;
        }
        if (string.IsNullOrWhiteSpace(editingEmployee.Email) || !editingEmployee.Email.Contains("@"))
        {
            errorMessage = "Vui lòng nhập email hợp lệ.";
            return;
        }

        try
        {
            if (editingEmployee.Id == 0)
            {
                await HRUseCase.AddEmployeeAsync(editingEmployee);
            }
            else
            {
                await HRUseCase.UpdateEmployeeAsync(editingEmployee);
            }

            isFormModalOpen = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi lưu dữ liệu: {ex.Message}";
        }
    }

    private void ConfirmDelete(Employee emp)
    {
        employeeToDelete = emp;
        isDeleteModalOpen = true;
    }

    private async Task ExecuteDelete()
    {
        if (employeeToDelete != null)
        {
            await HRUseCase.SoftDeleteEmployeeAsync(employeeToDelete.Id);
            isDeleteModalOpen = false;
            await LoadData();
        }
    }

    private async Task ExportToCsv()
    {
        var sb = new System.Text.StringBuilder();
        // UTF-8 BOM for Excel
        sb.Append('\uFEFF');
        sb.AppendLine("STT,Mã Nhân Viên,Họ và Tên,Giới Tính,Ngày Sinh,Số Điện Thoại,Email,Địa Chỉ,Phòng Ban,Chức Vụ,Ngày Vào Làm,Loại Hợp Đồng,Hạn Hợp Đồng,Lương Cơ Bản,Phụ Cấp,Trạng Thái");

        int i = 1;
        foreach (var emp in filteredEmployees)
        {
            sb.AppendLine($"{i++},\"{emp.EmployeeCode}\",\"{emp.FullName}\",\"{emp.Gender}\",\"{emp.DateOfBirth:dd/MM/yyyy}\",\"{emp.PhoneNumber}\",\"{emp.Email}\",\"{emp.Address}\",\"{emp.DepartmentName}\",\"{emp.PositionTitle}\",\"{emp.HireDate:dd/MM/yyyy}\",\"{emp.ContractType}\",\"{emp.ContractEndDate:dd/MM/yyyy}\",{emp.BaseSalary},{emp.Allowance},\"{emp.WorkStatus}\"");
        }

        string csvContent = sb.ToString();
        string fileName = $"Danh_Sach_Nhan_Vien_KimLongEcoStay_{DateTime.Today:yyyyMMdd}.csv";

        await JSRuntime.InvokeVoidAsync("downloadFileFromText", fileName, csvContent, "text/csv;charset=utf-8;");
    }

    private string GetStatusBadge(string status) => status switch
    {
        "Đang làm việc" => "bg-success",
        "Nghỉ phép" => "bg-warning text-dark",
        "Tạm nghỉ" => "bg-secondary",
        "Đã nghỉ việc" => "bg-danger",
        _ => "bg-light text-dark"
    };
}
