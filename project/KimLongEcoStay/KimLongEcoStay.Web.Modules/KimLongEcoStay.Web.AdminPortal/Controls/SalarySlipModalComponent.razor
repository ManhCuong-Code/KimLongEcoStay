@inject IJSRuntime JSRuntime

@if (IsOpen && Payroll != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(10, 61, 44, 0.65); backdrop-filter: blur(4px); z-index: 1060;">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <!-- Modal Header -->
                <div class="modal-header text-white px-4 py-3" style="background: linear-gradient(135deg, #0A3D2C 0%, #14533D 100%); border-bottom: 2px solid #D4AF37;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-spreadsheet-fill text-warning fs-4"></i>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">PHIẾU LƯƠNG ĐIỆN TỬ — KIM LONG ECOSTAY</h5>
                            <small class="text-warning opacity-90">Kỳ thanh toán: Tháng @Payroll.Month/@Payroll.Year • Mã phiếu: @Payroll.PayrollCode</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>

                <!-- Modal Body: Printable Payslip -->
                <div class="modal-body p-4 bg-light" id="printable-payslip">
                    <div class="card border border-2 p-4 bg-white shadow-sm" style="border-color: #e2e8f0 !important; border-radius: 12px;">
                        <!-- Payslip Branding & Header -->
                        <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-3">
                                <img src="/images/logo.jpg" alt="Kim Long EcoStay" style="width: 58px; height: 58px; border-radius: 50%; border: 2px solid #D4AF37; object-fit: cover;" onerror="this.src='favicon.png'" />
                                <div>
                                    <h5 class="fw-bold text-dark mb-0 font-serif" style="color: #0A3D2C !important;">KIM LONG ECOSTAY JSC</h5>
                                    <small class="text-muted d-block">Mô Hình Nghỉ Dưỡng Nhà Vườn Sinh Thái & Di Sản Cố Đô</small>
                                    <small class="text-muted"><i class="bi bi-geo-alt me-1 text-danger"></i>Phường Kim Long, TP. Huế • Hotline: 0905.123.456</small>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge @Payroll.StatusBadgeClass fs-6 px-3 py-2 rounded-pill shadow-sm">
                                    <i class="bi bi-check2-circle me-1"></i>@Payroll.StatusDisplay
                                </span>
                                <div class="text-muted small mt-1">Ngày xuất: @DateTime.Today.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>

                        <!-- Title -->
                        <div class="text-center my-3">
                            <h4 class="fw-bold font-serif text-uppercase mb-1" style="color: #0A3D2C; letter-spacing: 0.5px;">
                                PHIẾU THANH TOÁN LƯƠNG NHÂN VIÊN
                            </h4>
                            <p class="text-muted small mb-0">
                                Kỳ tính lương: <strong>Tháng @Payroll.Month năm @Payroll.Year</strong> • Số: <code>@Payroll.PayrollCode</code>
                            </p>
                        </div>

                        <!-- Employee Info Box -->
                        <div class="row g-3 p-3 mb-4 rounded-3" style="background-color: #F8FAF9; border: 1px dashed #CBD5E1;">
                            <div class="col-md-6">
                                <div class="small text-muted">Họ và tên nhân viên:</div>
                                <div class="fw-bold text-dark fs-6">@Payroll.EmployeeName</div>
                            </div>
                            <div class="col-md-3">
                                <div class="small text-muted">Mã nhân viên:</div>
                                <div class="fw-bold text-primary font-monospace">@Payroll.EmployeeCode</div>
                            </div>
                            <div class="col-md-3">
                                <div class="small text-muted">Phòng ban:</div>
                                <div class="fw-bold text-dark">@Payroll.DepartmentName</div>
                            </div>
                            <div class="col-md-6">
                                <div class="small text-muted">Chức danh / Vị trí:</div>
                                <div class="fw-semibold text-dark">@Payroll.PositionTitle</div>
                            </div>
                            <div class="col-md-6">
                                <div class="small text-muted">Hình thức chi trả:</div>
                                <div class="fw-semibold text-success"><i class="bi bi-qr-code me-1"></i>@Payroll.PaymentMethod</div>
                            </div>
                        </div>

                        <!-- Salary Details Table -->
                        <div class="table-responsive mb-3">
                            <table class="table table-bordered align-middle mb-0">
                                <thead style="background-color: #EDF7F2;">
                                    <tr>
                                        <th class="text-center" style="width: 8%;">STT</th>
                                        <th>Khoản Mục Thu Nhập & Khấu Trừ</th>
                                        <th class="text-center" style="width: 25%;">Quy Cách / Ghi Chú</th>
                                        <th class="text-end" style="width: 25%;">Số Tiền (VNĐ)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="fw-bold bg-light">
                                        <td colspan="4" class="text-success"><i class="bi bi-plus-circle me-1"></i>I. CÁC KHOẢN THU NHẬP (A)</td>
                                    </tr>
                                    <tr>
                                        <td class="text-center">1</td>
                                        <td>Lương cơ bản theo hợp đồng</td>
                                        <td class="text-center text-muted small">Mức thỏa thuận</td>
                                        <td class="text-end fw-semibold">@Payroll.BaseSalary.ToString("N0") đ</td>
                                    </tr>
                                    <tr>
                                        <td class="text-center">2</td>
                                        <td>Phụ cấp (trách nhiệm, ăn trưa, điện thoại)</td>
                                        <td class="text-center text-muted small">Cố định tháng</td>
                                        <td class="text-end fw-semibold">@Payroll.Allowance.ToString("N0") đ</td>
                                    </tr>
                                    <tr>
                                        <td class="text-center">3</td>
                                        <td>Tiền thưởng hiệu quả / KPI</td>
                                        <td class="text-center text-muted small">Đánh giá chất lượng</td>
                                        <td class="text-end fw-semibold text-success">+ @Payroll.Bonus.ToString("N0") đ</td>
                                    </tr>
                                    <tr>
                                        <td class="text-center">4</td>
                                        <td>Tiền làm thêm giờ (Overtime)</td>
                                        <td class="text-center text-muted small">Trực tour & lễ tân đêm</td>
                                        <td class="text-end fw-semibold text-success">+ @Payroll.OvertimePay.ToString("N0") đ</td>
                                    </tr>
                                    <tr class="table-success fw-bold">
                                        <td colspan="3" class="text-end text-dark">TỔNG THU NHẬP (GROSS INCOME)</td>
                                        <td class="text-end text-success fs-6">@Payroll.GrossIncome.ToString("N0") đ</td>
                                    </tr>

                                    <tr class="fw-bold bg-light">
                                        <td colspan="4" class="text-danger"><i class="bi bi-dash-circle me-1"></i>II. CÁC KHOẢN TRÍCH KHẤU TRỪ (B)</td>
                                    </tr>
                                    <tr>
                                        <td class="text-center">5</td>
                                        <td>Bảo hiểm xã hội, BHYT & BHTN</td>
                                        <td class="text-center text-muted small">Trích nộp theo luật định</td>
                                        <td class="text-end text-danger">- @Payroll.Deductions.ToString("N0") đ</td>
                                    </tr>
                                    @if (Payroll.AdvancePayment > 0)
                                    {
                                        <tr>
                                            <td class="text-center">6</td>
                                            <td>Tạm ứng lương trong tháng</td>
                                            <td class="text-center text-muted small">Đã ứng giữa kỳ</td>
                                            <td class="text-end text-danger">- @Payroll.AdvancePayment.ToString("N0") đ</td>
                                        </tr>
                                    }
                                    <tr class="table-danger fw-bold">
                                        <td colspan="3" class="text-end text-dark">TỔNG KHẤU TRỪ</td>
                                        <td class="text-end text-danger">@((Payroll.Deductions + Payroll.AdvancePayment).ToString("N0")) đ</td>
                                    </tr>

                                    <!-- NET PAY HIGHLIGHT -->
                                    <tr style="background-color: #FEF3C7; border-top: 2px solid #D4AF37;">
                                        <td colspan="3" class="text-end py-3">
                                            <span class="fs-5 fw-bold text-dark text-uppercase">THỰC LĨNH CHUYỂN KHOẢN (NET INCOME):</span>
                                            <div class="small text-muted fst-italic">Bằng chữ: @NumberToWordsVietnamese(Payroll.NetIncome)</div>
                                        </td>
                                        <td class="text-end py-3">
                                            <div class="fs-4 fw-bold text-danger">@Payroll.NetIncome.ToString("N0") đ</div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Signatures Box -->
                        <div class="row text-center mt-4 pt-3 border-top g-3">
                            <div class="col-4">
                                <div class="fw-bold text-dark small text-uppercase">Người Lập Phiếu</div>
                                <div class="text-muted small fst-italic">(Ký & ghi rõ họ tên)</div>
                                <div style="height: 50px;"></div>
                                <div class="fw-semibold text-dark small">Phòng Kế Toán</div>
                            </div>
                            <div class="col-4">
                                <div class="fw-bold text-dark small text-uppercase">Kế Toán Trưởng</div>
                                <div class="text-muted small fst-italic">(Ký & ghi rõ họ tên)</div>
                                <div style="height: 50px;"></div>
                                <div class="fw-semibold text-dark small">Trần Minh Khoa</div>
                            </div>
                            <div class="col-4">
                                <div class="fw-bold text-dark small text-uppercase">Giám Đốc Phê Duyệt</div>
                                <div class="text-muted small fst-italic">(Ký & đóng dấu)</div>
                                <div style="height: 50px;"></div>
                                <div class="fw-semibold text-dark small">@(Payroll.ApprovedBy ?? "Trần Thị Thu")</div>
                            </div>
                        </div>

                        <div class="text-center mt-3 pt-2 text-muted small border-top fst-italic">
                            * Mọi thắc mắc về bảng tính lương xin vui lòng phản hồi phòng Kế toán — Nhân sự Kim Long EcoStay trong vòng 03 ngày làm việc.
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer bg-white px-4 py-3 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="Close">
                        <i class="bi bi-x-circle me-1"></i>Đóng
                    </button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-primary rounded-pill px-4" @onclick="PrintPayslip">
                            <i class="bi bi-printer-fill me-1"></i>In Phiếu Lương
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Payroll? Payroll { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task PrintPayslip()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    // Helper chuyển số tiền thành chữ tiếng Việt
    private string NumberToWordsVietnamese(decimal amount)
    {
        long n = (long)amount;
        if (n == 0) return "Không đồng";

        string[] units = { "", "nghìn", "triệu", "tỷ" };
        List<string> parts = new();
        int unitIndex = 0;

        while (n > 0)
        {
            long group = n % 1000;
            if (group > 0)
            {
                string groupStr = GroupToText((int)group);
                parts.Insert(0, $"{groupStr} {units[unitIndex]}".Trim());
            }
            n /= 1000;
            unitIndex++;
        }

        string result = string.Join(" ", parts).Trim();
        if (result.Length > 0)
        {
            result = char.ToUpper(result[0]) + result.Substring(1) + " đồng chẵn.";
        }
        return result;
    }

    private string GroupToText(int number)
    {
        string[] digits = { "không", "một", "hai", "ba", "bốn", "năm", "sáu", "bảy", "tám", "chín" };
        int h = number / 100;
        int t = (number % 100) / 10;
        int o = number % 10;

        string s = "";
        if (h > 0) s += digits[h] + " trăm ";
        if (t > 1)
        {
            s += digits[t] + " mươi ";
            if (o == 1) s += "mốt";
            else if (o == 5) s += "lăm";
            else if (o > 0) s += digits[o];
        }
        else if (t == 1)
        {
            s += "mười ";
            if (o == 5) s += "lăm";
            else if (o > 0) s += digits[o];
        }
        else if (o > 0)
        {
            if (h > 0) s += "lẻ ";
            s += digits[o];
        }
        return s.Trim();
    }
}
