# ============================================================================
# KIM LONG ECOSTAY - ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and fill in your actual credentials locally.
# NEVER commit .env or real API keys to GitHub!
# ============================================================================

# 1. AI Assistant Provider & Model Configuration
AI_PROVIDER=OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MAX_TOKENS=900
AI_RATE_LIMIT_PER_MINUTE=20

# Optional Secondary Provider (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. SQL Server Two-Way Sync Connection String
SQL_CONNECTION_STRING=Server=localhost\SQLEXPRESS;Database=KimLongEcoStayDB;Trusted_Connection=True;TrustServerCertificate=True;
SQL_SYNC_POLL_INTERVAL_MS=1500

# 3. Google Gmail API v1 & OAuth 2.0 Web Server Flow
EMAIL_PROVIDER=Gmail
GMAIL_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_REDIRECT_URI=http://localhost:5204/api/admin/gmail/oauth2callback
GMAIL_SENDER=your_admin_email@gmail.com
ADMIN_EMAIL=your_admin_email@gmail.com
GMAIL_REFRESH_TOKEN=optional_refresh_token_if_pregenerated

