@inherits LayoutComponentBase

<PageTitle>Kim Long EcoStay — Nghỉ Dưỡng Nhà Vườn Sinh Thái & Di Sản Cố Đô Huế</PageTitle>

<div class="d-flex flex-column min-vh-100">
    <TopNavbar></TopNavbar>

    <main class="flex-grow-1">
        @Body
    </main>

    <!-- FOOTER CHUYÊN NGHIỆP CẤP ĐIỀU HÀNH -->
    <footer class="kle-footer" id="contact">
        <div class="container">
            <div class="row g-4">
                <!-- Cột 1: Thông tin pháp nhân & Thương hiệu -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="/images/logo.jpg" alt="Logo Kim Long EcoStay" style="width: 50px; height: 50px; border-radius: 50%; border: 2px solid var(--kle-gold); object-fit: cover;" onerror="this.src='favicon.png'" />
                        <div>
                            <div class="footer-brand-title mb-0">Kim Long EcoStay</div>
                            <small class="text-warning">Mô Hình Homestay Nhà Vườn Sinh Thái</small>
                        </div>
                    </div>
                    <div class="footer-slogan">"Trải nghiệm văn hóa • Gắn kết thiên nhiên"</div>
                    <p class="text-light-muted small" style="line-height: 1.7;">
                        Nền tảng đặt phòng trực tuyến kết hợp du lịch di sản thông minh đầu tiên tại làng cổ Kim Long — TP. Huế. 
                        Liên kết win-win với hệ thống nhà vườn cổ trăm năm và ứng dụng công nghệ SmartLock IoT tự động hóa 100%.
                    </p>
                    <div class="mt-3">
                        <span class="badge bg-success bg-opacity-25 text-success border border-success p-2 small">
                            🌱 Dự án Khởi Nghiệp ĐMST 2026 — ĐH Kinh Tế Huế
                        </span>
                    </div>
                </div>

                <!-- Cột 2: Danh Mục Phòng & Tiện Ích -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="text-gold fw-bold text-uppercase mb-3" style="letter-spacing: 1px;">Buồng Phòng</h6>
                    <ul class="footer-link-list">
                        <li><a href="room/1"><i class="bi bi-chevron-right small me-1"></i>Eco-Nest Ban Mai</a></li>
                        <li><a href="room/2"><i class="bi bi-chevron-right small me-1"></i>Eco-Nest Hoàng Hôn</a></li>
                        <li><a href="room/3"><i class="bi bi-chevron-right small me-1"></i>Garden Suite Thanh Trà</a></li>
                        <li><a href="room/4"><i class="bi bi-chevron-right small me-1"></i>Family Eco-Villa</a></li>
                        <li><a href="room/5"><i class="bi bi-chevron-right small me-1"></i>Heritage Studio</a></li>
                    </ul>
                </div>

                <!-- Cột 3: Trải Nghiệm Di Sản & Cam Kết -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-gold fw-bold text-uppercase mb-3" style="letter-spacing: 1px;">Cam Kết Dịch Vụ</h6>
                    <ul class="footer-link-list">
                        <li><a href="#amenities"><i class="bi bi-shield-check me-2 text-success"></i>0% Trùng phòng (Overbooking)</a></li>
                        <li><a href="#amenities"><i class="bi bi-qr-code me-2 text-warning"></i>Cọc 50% VietQR tự động</a></li>
                        <li><a href="#amenities"><i class="bi bi-arrow-repeat me-2 text-info"></i>Hoàn cọc 100% trước 48h</a></li>
                        <li><a href="#heritage-map"><i class="bi bi-headphones me-2 text-primary"></i>GPS Audio Guide 3 ngôn ngữ</a></li>
                        <li><a href="#heritage-map"><i class="bi bi-bicycle me-2 text-success"></i>Xe đạp trợ lực điện Eco-Bike</a></li>
                    </ul>
                </div>

                <!-- Cột 4: Thông Tin Liên Hệ & Đội Ngũ -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-gold fw-bold text-uppercase mb-3" style="letter-spacing: 1px;">Liên Hệ & Đón Tiếp</h6>
                    <div class="footer-contact-item">
                        <i class="bi bi-geo-alt-fill text-danger fs-5 mt-1"></i>
                        <div>
                            <strong>Địa chỉ:</strong> Phường Kim Long, Thành phố Huế (Bờ bắc sông Hương, cạnh Chùa Thiên Mụ)
                        </div>
                    </div>
                    <div class="footer-contact-item">
                        <i class="bi bi-telephone-fill text-warning fs-5"></i>
                        <div>
                            <strong>Hotline / Zalo:</strong> <a href="tel:0905123456" class="text-warning fw-bold text-decoration-none">0905.123.456</a>
                        </div>
                    </div>
                    <div class="footer-contact-item">
                        <i class="bi bi-envelope-fill text-info fs-5"></i>
                        <div>
                            <strong>Email:</strong> contact@kimlongecostay.vn
                        </div>
                    </div>
                    <div class="footer-contact-item">
                        <i class="bi bi-clock-fill text-success fs-5"></i>
                        <div>
                            <strong>Check-in / Check-out:</strong> 14:00 | 12:00
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dòng Bản quyền & Nhóm Tác Giả -->
            <div class="footer-bottom-bar">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                    <div>
                        © 2026 <strong>CÔNG TY CỔ PHẦN KIM LONG ECOSTAY (KIM LONG ECOSTAY JSC)</strong>. Tất cả quyền được bảo lưu.
                    </div>
                    <div>
                        <span class="text-muted">GVHD: TS. Nguyễn Minh Đức • Nhóm đề tài: Thu (CEO), Quyết (CTO), Cường (COO), Kiệt (CMO), Khoa (CFO)</span>
                    </div>
                </div>
            </div>
        </div>
    </footer>
</div>

<!-- TRỢ LÝ AI HOMESTAY NỔI TRÊN MÀN HÌNH (TOÀN BỘ CÁC TRANG) -->
<FloatingHomestayAiComponent />

<div id="blazor-error-ui" data-nosnippet>
    Đã xảy ra lỗi kết nối.
    <a href="." class="reload text-warning">Tải lại trang</a>
    <span class="dismiss">🗙</span>
</div>
