@using Microsoft.AspNetCore.Components.Authorization

<nav class="navbar navbar-expand-xl navbar-dark kle-navbar px-3 px-lg-4 py-2 sticky-top shadow">
    <div class="container-fluid">
        <!-- Logo & Thương hiệu -->
        <a class="brand-badge" href="">
            <img src="images/logo.jpg" alt="Kim Long EcoStay" class="brand-logo-img" onerror="this.src='favicon.png'" />
            <div>
                <span class="brand-text-title">Kim Long EcoStay</span>
                <span class="brand-text-sub">Nhà Vườn Sinh Thái • Huế</span>
            </div>
        </a>

        <!-- Nút Giỏ Hàng di động -->
        <div class="d-flex align-items-center d-xl-none ms-auto me-2">
            <KimLongEcoStay.Web.CustomerPortal.Controls.CartComponent />
        </div>

        <!-- Toggle Button -->
        <button class="navbar-toggler border-0 shadow-none p-1" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
            <!-- Navigation Menu Chính -->
            <ul class="navbar-nav me-auto mb-2 mb-xl-0 ms-xl-3 align-items-xl-center gap-1">
                <li class="nav-item">
                    <NavLink class="nav-link kle-nav-item" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-house-door me-1"></i>Trang Chủ
                    </NavLink>
                </li>
                <li class="nav-item">
                    <a class="nav-link kle-nav-item" href="#rooms">
                        <i class="bi bi-door-open me-1"></i>Phòng Nghỉ
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link kle-nav-item" href="#gallery">
                        <i class="bi bi-images me-1"></i>Không Gian
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link kle-nav-item" href="#story">
                        <i class="bi bi-flower1 me-1"></i>Văn Hóa
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link kle-nav-item" href="#heritage-map">
                        <i class="bi bi-map-fill me-1"></i>Bản Đồ Di Tích
                    </a>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link kle-nav-item fw-bold text-warning" href="lookup">
                        <i class="bi bi-key-fill me-1"></i>Tra Cứu Khóa
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link kle-nav-item fw-bold text-emerald" href="ai-assistant">
                        <i class="bi bi-robot text-success me-1"></i>Trợ Lý AI
                    </NavLink>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle kle-nav-item fw-semibold text-light opacity-90" href="javascript:void(0)" id="subpagesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-grid-fill me-1 text-gold"></i>Phân Hệ
                    </a>
                    <ul class="dropdown-menu shadow-lg border-0 rounded-3 p-2" aria-labelledby="subpagesDropdown" style="min-width: 220px;">
                        <li><a class="dropdown-item rounded-2 py-2 fw-semibold" href="dashboard"><i class="bi bi-graph-up-arrow text-success me-2"></i>Dashboard Tài Chính</a></li>
                        <li><a class="dropdown-item rounded-2 py-2 fw-semibold" href="nhanvien"><i class="bi bi-people-fill text-primary me-2"></i>Quản Lý Nhân Sự</a></li>
                        <li><a class="dropdown-item rounded-2 py-2 fw-semibold" href="luong"><i class="bi bi-cash-stack text-warning me-2"></i>Quản Lý Tiền Lương</a></li>
                        <li><a class="dropdown-item rounded-2 py-2 fw-semibold" href="duan"><i class="bi bi-kanban text-info me-2"></i>Quản Lý Buồng Phòng</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item rounded-2 py-2 fw-bold text-success" href="admin"><i class="bi bi-shield-lock-fill me-2"></i>Cổng Quản Trị (Admin)</a></li>
                    </ul>
                </li>
            </ul>

            <!-- Hotline & Phân Quyền Đăng Nhập -->
            <ul class="navbar-nav ms-auto align-items-xl-center gap-2">
                <!-- Hotline 24/7 -->
                <li class="nav-item d-none d-xxl-block">
                    <a href="tel:0905123456" class="hotline-pill">
                        <i class="bi bi-telephone-fill"></i>
                        <span>0905.123.456</span>
                    </a>
                </li>

                <!-- Giỏ Hàng Desktop -->
                <li class="nav-item d-none d-xl-block">
                    <KimLongEcoStay.Web.CustomerPortal.Controls.CartComponent />
                </li>

                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <a class="btn btn-warning btn-sm fw-bold text-dark px-3 py-1 rounded-pill shadow-sm" href="admin" title="Cổng điều hành & quản trị homestay">
                                <i class="bi bi-shield-lock-fill me-1"></i>Quản Trị
                            </a>
                        </li>
                        @if (context.User.IsInRole("Admin") || context.User.IsInRole("Staff") || context.User.IsInRole("Administrator") || context.User.IsInRole("Manager") || context.User.IsInRole("HR") || context.User.IsInRole("Accountant"))
                        {
                            <li class="nav-item text-light small d-none d-xxl-inline">
                                <span class="badge bg-success border border-light"><i class="bi bi-person-badge me-1"></i>@context.User.Identity?.Name</span>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item text-light small">
                                <span class="badge bg-info text-dark"><i class="bi bi-person me-1"></i>Khách: @context.User.Identity?.Name</span>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1" href="logout">
                                <i class="bi bi-box-arrow-right me-1"></i>Thoát
                            </a>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item">
                            <a class="btn btn-warning btn-sm fw-bold text-dark px-3 py-1 rounded-pill shadow-sm" href="admin" title="Cổng điều hành & quản trị homestay">
                                <i class="bi bi-shield-lock-fill me-1"></i>Quản Trị
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm rounded-pill px-3 py-1" href="login">
                                <i class="bi bi-person me-1"></i>Đăng Nhập
                            </a>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</nav>
