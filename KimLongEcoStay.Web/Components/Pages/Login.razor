@page "/login"

<PageTitle>Đăng Nhập Hệ Thống - Kim Long EcoStay</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <!-- Banner giải thích rõ cấu trúc phân quyền -->
            <div class="alert alert-info border-0 shadow-sm rounded-3 mb-4 p-3">
                <div class="d-flex align-items-center">
                    <i class="bi bi-info-circle-fill text-primary fs-3 me-3"></i>
                    <div>
                        <h6 class="fw-bold mb-1 text-primary">Cấu Trúc Phân Quyền Hệ Thống Kim Long EcoStay</h6>
                        <ul class="mb-0 ps-3 small text-secondary">
                            <li><strong>Khách hàng:</strong> Có thể đặt phòng trực tuyến ngay <em>mà không cần đăng nhập</em>, hoặc đăng nhập để quản lý lịch sử cá nhân.</li>
                            <li><strong>Nhân viên / Quản trị:</strong> <em>Bắt buộc phải đăng nhập</em> để vào hệ thống kiểm tra đơn đặt phòng, duyệt cọc và quản lý buồng phòng.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white text-center py-4">
                    <div class="badge bg-warning text-dark px-3 py-2 mb-2 fw-bold text-uppercase">
                        <i class="bi bi-shield-lock-fill me-1"></i>Xác Thực & Phân Quyền
                    </div>
                    <h4 class="mb-0 fw-bold">Đăng Nhập Hệ Thống</h4>
                    <p class="small text-white-50 mb-0 mt-1">Hệ thống đặt phòng trực tuyến Kim Long EcoStay (Cố Đô Huế)</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center rounded-3">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                            <div>@errorMessage</div>
                        </div>
                    }

                    <!-- HTML Form POST tới Minimal API /authenticate (Set Cookie Authentication) -->
                    <!-- data-enhance="false" bắt buộc để trình duyệt thực hiện Full HTTP POST & Cookie Set thay vì AJAX fetch -->
                    <form method="post" action="/authenticate" id="loginForm" data-enhance="false">
                        <AntiforgeryToken />
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Tên Đăng Nhập / Tài Khoản:</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-person-circle text-muted"></i></span>
                                <input type="text" id="usernameInput" name="username" class="form-control border-start-0" 
                                       placeholder="Ví dụ: letan hoặc admin" required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Mật Khẩu:</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-key-fill text-muted"></i></span>
                                <input type="password" id="passwordInput" name="password" class="form-control border-start-0" 
                                       placeholder="Mật khẩu: 123456" required />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-3 shadow-sm mb-3">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Đăng Nhập Vào Hệ Thống
                        </button>
                    </form>

                    <!-- Khung Đăng Nhập Nhanh 1-Click Cực Tiện Lợi Cho Chấm Điểm & Kiểm Thử -->
                    <div class="p-3 mb-3 bg-light rounded-3 border text-center">
                        <div class="small fw-bold text-dark mb-2">
                            <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Truy Cập Nhanh 1-Click (Không Cần Nhập Mật Khẩu):
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <a href="quick-login?role=admin" class="btn btn-sm btn-warning text-dark fw-bold px-3 py-2 shadow-sm rounded-pill flex-fill">
                                <i class="bi bi-shield-check me-1"></i>Vào Admin Portal (Quản Trị)
                            </a>
                            <a href="quick-login?role=letan" class="btn btn-sm btn-success fw-bold px-3 py-2 shadow-sm rounded-pill flex-fill">
                                <i class="bi bi-person-badge me-1"></i>Vào Host Portal (Lễ Tân)
                            </a>
                        </div>
                    </div>

                    <!-- Nút quay lại đặt phòng cho khách không cần đăng nhập -->
                    <div class="text-center pt-2 border-top">
                        <span class="text-muted small">Bạn là khách du lịch muốn đặt phòng nhanh?</span>
                        <div class="mt-2">
                            <a href="products" class="btn btn-outline-success btn-sm fw-bold px-3 py-2 rounded-pill">
                                <i class="bi bi-calendar-check me-1"></i>Đặt Phòng Ngay (Không Cần Đăng Nhập)
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Tài khoản thử nghiệm nhanh cho giáo viên / người chấm -->
                <div class="card-footer bg-light p-3">
                    <div class="fw-bold small text-muted mb-2"><i class="bi bi-stars text-warning me-1"></i>Điền sẵn thông tin mẫu (Mật khẩu chung: <code>123456</code>):</div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-sm btn-outline-warning text-dark flex-fill" 
                                onclick="document.getElementById('usernameInput').value='letan'; document.getElementById('passwordInput').value='123456';">
                            <i class="bi bi-person-badge me-1"></i><strong>letan</strong> (Nhân Viên)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary flex-fill" 
                                onclick="document.getElementById('usernameInput').value='admin'; document.getElementById('passwordInput').value='123456';">
                            <i class="bi bi-shield-check me-1"></i><strong>admin</strong> (Quản Trị)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-info text-dark flex-fill" 
                                onclick="document.getElementById('usernameInput').value='khachhang'; document.getElementById('passwordInput').value='123456';">
                            <i class="bi bi-person me-1"></i><strong>khachhang</strong> (Khách Đã ĐK)
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? error { get; set; }

    [SupplyParameterFromQuery]
    private string? role { get; set; }

    private string? errorMessage;

    protected override void OnParametersSet()
    {
        if (error == "invalid")
        {
            errorMessage = "Tên đăng nhập hoặc mật khẩu không chính xác! Vui lòng thử lại.";
        }
        else if (error == "denied")
        {
            errorMessage = "Bạn cần đăng nhập với vai trò Nhân Viên hoặc Quản Trị để truy cập khu vực này!";
        }
    }
}