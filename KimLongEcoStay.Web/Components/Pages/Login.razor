@page "/login"

<PageTitle>Đăng Nhập Cổng Điều Hành - Kim Long EcoStay</PageTitle>

<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: calc(100vh - 140px);">
    <div class="kle-login-card w-100" style="max-width: 460px;">
        <div class="kle-login-header">
            <div class="kle-login-icon-ring">
                <i class="bi bi-shield-lock-fill fs-3" style="color: #D4AF37;"></i>
            </div>
            <h5 class="fw-bold font-serif text-white mb-1">Đăng Nhập Cổng Điều Hành</h5>
            <p class="small mb-0" style="color: rgba(247, 248, 244, 0.8); font-size: 12.5px;">
                Kim Long EcoStay • Xác thực phân quyền theo vai trò
            </p>
        </div>

        <div class="kle-login-body">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-warning border-warning d-flex align-items-center rounded-3 small py-2 px-3 mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <div>@errorMessage</div>
                </div>
            }

            <form method="post" action="/authenticate" id="loginForm" data-enhance="false" autocomplete="off">
                <AntiforgeryToken />
                <div class="mb-3">
                    <label class="form-label small fw-bold mb-1" style="color: #26352B;">
                        <i class="bi bi-person-fill me-1" style="color: #14452F;"></i>Tên Đăng Nhập / Email
                    </label>
                    <input type="text" id="usernameInput" name="username" class="form-control kle-login-input"
                           placeholder="Nhập tên đăng nhập hoặc email công vụ" required />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold mb-1" style="color: #26352B;">
                        <i class="bi bi-key-fill me-1" style="color: #14452F;"></i>Mật Khẩu
                    </label>
                    <input type="password" id="passwordInput" name="password" class="form-control kle-login-input"
                           placeholder="Nhập mật khẩu điều hành" required />
                </div>

                <button type="submit" class="btn kle-btn-login-primary w-100 mb-3">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Đăng Nhập Hệ Thống
                </button>
            </form>

            <div class="border-top pt-3 text-center" style="border-color: #DDE5DF !important;">
                <div class="small text-muted" style="font-size: 12px;">
                    <i class="bi bi-shield-lock-fill text-success me-1"></i>Phiên đăng nhập được bảo vệ bằng Cookie <code>HttpOnly</code> và phân quyền RBAC tại máy chủ.
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? error { get; set; }

    [SupplyParameterFromQuery]
    private string? role { get; set; }

    private string? errorMessage;

    protected override void OnParametersSet()
    {
        if (error == "invalid")
        {
            errorMessage = "Tên đăng nhập hoặc mật khẩu không chính xác! Vui lòng thử lại.";
        }
        else if (error == "denied")
        {
            errorMessage = "Vui lòng đăng nhập với vai trò được cấp quyền để truy cập phân hệ quản trị!";
        }
    }
}
