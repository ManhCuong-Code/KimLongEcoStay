@page "/admin"
@page "/dashboard"
@page "/nhanvien"
@page "/luong"
@page "/duan"
@attribute [Authorize(Roles = "Admin,Administrator,Staff,Manager,HR,Accountant")]
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject KimLongEcoStay.Web.Services.TwoWaySqlSyncService SqlSyncService
@inject KimLongEcoStay.Web.Services.AiAssistantGatewayService AiGatewayService

<PageTitle>Trung Tâm Quản Trị &amp; Vận Hành - Kim Long EcoStay</PageTitle>

<div class="kle-admin-shell d-flex flex-column" style="min-height: calc(100vh - 76px);">
    <!-- Topbar Quản Trị -->
    <div class="kle-admin-topbar px-3 px-lg-4 py-2.5 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn btn-sm rounded-3 px-2.5 py-1.5" style="background: rgba(255,255,255,0.12); color: #D4AF37; border: 1px solid rgba(212,175,55,0.4);" @onclick="ToggleSidebar" title="Thu gọn / Mở rộng Sidebar">
                <i class="bi bi-layout-sidebar-inset fs-6"></i>
            </button>
            <div>
                <div class="d-flex align-items-center gap-2 flex-wrap mb-0.5">
                    <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background: #D4AF37; color: #14452F;">
                        <i class="bi bi-shield-lock-fill me-1"></i>CỔNG ĐIỀU HÀNH NỘI BỘ
                    </span>
                    <AuthorizeView>
                        <Authorized>
                            <span class="badge rounded-pill px-2.5 py-1" style="background: rgba(30, 107, 69, 0.85); border: 1px solid #D4AF37; color: #FFFFFF;">
                                <i class="bi bi-cpu-fill me-1" style="color: #D4AF37;"></i>5 Khóa IoT Online
                            </span>
                            <span class="badge rounded-pill px-2.5 py-1" style="background: #F7F8F4; color: #14452F; font-weight: 700;">
                                <i class="bi bi-person-check-fill me-1" style="color: #1E6B45;"></i>@context.User.Identity?.Name
                            </span>
                            <span class="badge rounded-pill px-2.5 py-1" style="background: #D4AF37; color: #14452F; font-weight: 800;">
                                @GetUserRole(context.User)
                            </span>
                        </Authorized>
                    </AuthorizeView>
                </div>
                <h5 class="font-serif fw-bold text-white mb-0" style="font-size: 17px;">
                    Trung Tâm Quản Trị &amp; Vận Hành Kim Long EcoStay
                </h5>
            </div>
        </div>

        <div class="d-flex gap-2 align-items-center">
            <a href="" class="btn btn-sm rounded-pill px-3 py-1 fw-semibold" style="background: rgba(255,255,255,0.12); color: #F7F8F4; border: 1px solid rgba(255,255,255,0.25);">
                <i class="bi bi-house me-1"></i>Trang Khách Hàng
            </a>
            <a href="logout" class="btn btn-sm rounded-pill px-3 py-1 fw-bold" style="background: rgba(220, 38, 38, 0.9); color: #FFFFFF; border: 1px solid rgba(255,255,255,0.3);">
                <i class="bi bi-box-arrow-right me-1"></i>Đăng Xuất
            </a>
        </div>
    </div>

    <!-- Workspace: Left Collapsible Sidebar + Right Main Content -->
    <div class="kle-admin-workspace flex-grow-1">
        <aside class="kle-admin-sidebar @(isSidebarCollapsed ? "collapsed" : "")">
            <div class="py-2">
                <div class="kle-sidebar-group-label">DANH MỤC PHÂN HỆ ĐƯỢC CẤP QUYỀN</div>
                @foreach (var mod in AllowedModules)
                {
                    var m = mod;
                    <button type="button"
                            class="kle-sidebar-item @(mainTab == m.Id ? "active" : "")"
                            title="@m.Title"
                            @onclick="() => SwitchMainTab(m.Id)">
                        <span class="kle-sidebar-icon"><i class="bi @m.Icon"></i></span>
                        <span class="kle-sidebar-text">@m.Title</span>
                    </button>
                }
            </div>

            <div class="kle-sidebar-footer">
                <div class="kle-sidebar-role-switcher mb-2">
                    <div class="small fw-bold mb-1.5" style="color: #D4AF37; font-size: 10.5px;">
                        <i class="bi bi-person-gear me-1"></i>CHUYỂN NHANH VAI TRÒ (RBAC):
                    </div>
                    <div class="d-grid gap-1" style="grid-template-columns: repeat(2, 1fr);">
                        <a href="quick-login?role=admin" class="btn btn-sm py-1 px-2 text-start rounded-2 fw-bold text-decoration-none" style="font-size: 11px; background: rgba(255,255,255,0.1); color: #F7F8F4; border: 1px solid rgba(212,175,55,0.35);">👑 Admin</a>
                        <a href="quick-login?role=letan" class="btn btn-sm py-1 px-2 text-start rounded-2 fw-bold text-decoration-none" style="font-size: 11px; background: rgba(255,255,255,0.1); color: #F7F8F4; border: 1px solid rgba(212,175,55,0.35);">🛎️ Lễ Tân</a>
                        <a href="quick-login?role=ketoan" class="btn btn-sm py-1 px-2 text-start rounded-2 fw-bold text-decoration-none" style="font-size: 11px; background: rgba(255,255,255,0.1); color: #F7F8F4; border: 1px solid rgba(212,175,55,0.35);">💰 Kế Toán</a>
                        <a href="quick-login?role=nhansu" class="btn btn-sm py-1 px-2 text-start rounded-2 fw-bold text-decoration-none" style="font-size: 11px; background: rgba(255,255,255,0.1); color: #F7F8F4; border: 1px solid rgba(212,175,55,0.35);">📋 Nhân Sự</a>
                    </div>
                </div>
                <button type="button" class="btn btn-sm w-100 rounded-2 py-1 d-none d-lg-flex align-items-center justify-content-center gap-2" style="background: rgba(212, 175, 55, 0.15); color: #D4AF37; border: 1px solid rgba(212, 175, 55, 0.35); font-size: 12px; font-weight: 600;" @onclick="ToggleSidebar">
                    <i class="bi @(isSidebarCollapsed ? "bi-arrows-angle-expand" : "bi-arrows-angle-contract")"></i>
                    <span class="kle-sidebar-collapse-text">@(isSidebarCollapsed ? "" : "Thu Gọn Menu")</span>
                </button>
            </div>
        </aside>

        <div class="kle-admin-main">
            @if (!string.IsNullOrEmpty(rbacNotice))
            {
                <div class="alert alert-warning border-warning d-flex align-items-center justify-content-between py-2 px-3 rounded-3 mb-3 small">
                    <div><i class="bi bi-shield-exclamation me-2"></i>@rbacNotice</div>
                    <button type="button" class="btn-close btn-sm" @onclick="() => rbacNotice = null"></button>
                </div>
            }

            <!-- Header của phân hệ đang mở -->
            <div class="kle-admin-module-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px; background: #14452F; color: #D4AF37; font-size: 20px;">
                        <i class="bi @CurrentModule.Icon"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0.5" style="color: #14452F; font-size: 17px;">@CurrentModule.Title</h5>
                        <p class="small mb-0" style="color: #526358;">@CurrentModule.Description</p>
                    </div>
                </div>
                <span class="badge rounded-pill px-3 py-1.5" style="background: #EDF7F2; color: #14452F; border: 1px solid #1E6B45; font-size: 11.5px;">
                    <i class="bi bi-shield-check me-1"></i>Phân quyền RBAC hợp lệ
                </span>
            </div>

            @if (mainTab == "dashboard" && CanAccessModule("dashboard"))
            {
                <KimLongEcoStay.Web.AdminPortal.Controls.FinancialDashboardComponent />
            }
            else if (mainTab == "luong" && CanAccessModule("luong"))
            {
                <KimLongEcoStay.Web.AdminPortal.Controls.PayrollManagementComponent />
            }
            else if (mainTab == "nhanvien" && CanAccessModule("nhanvien"))
            {
                <KimLongEcoStay.Web.AdminPortal.Controls.HRManagementComponent />
                <div class="mt-4">
                    <KimLongEcoStay.Web.AdminPortal.Controls.EmployeeManagementComponent />
                </div>
            }
            else if (mainTab == "reconciliation" && CanAccessModule("reconciliation"))
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4 p-4 bg-white">
                    <KimLongEcoStay.Web.AdminPortal.Controls.OutstandingOrdersComponent />
                    <div class="mt-4 pt-3 border-top">
                        <KimLongEcoStay.Web.AdminPortal.Controls.ActiveBookingsComponent />
                    </div>
                </div>
            }
            else if (mainTab == "duan" && CanAccessModule("duan"))
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom p-3">
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-sm rounded-pill px-3 fw-bold @(operationSubTab == "rooms" ? "btn-success" : "btn-outline-success")"
                                    @onclick='() => operationSubTab = "rooms"'>
                                <i class="bi bi-door-open-fill me-1"></i>1. Tình Trạng 05 Buồng Phòng
                            </button>
                            <button class="btn btn-sm rounded-pill px-3 fw-bold @(operationSubTab == "smartlock" ? "btn-success" : "btn-outline-success")"
                                    @onclick='() => operationSubTab = "smartlock"'>
                                <i class="bi bi-key-fill me-1"></i>2. Tra Cứu Khóa &amp; SmartLock IoT Hub
                            </button>
                            <button class="btn btn-sm rounded-pill px-3 fw-bold @(operationSubTab == "checkinout" ? "btn-success" : "btn-outline-success")"
                                    @onclick='() => operationSubTab = "checkinout"'>
                                <i class="bi bi-bicycle me-1"></i>3. Giao Phòng &amp; Check-in / Check-out
                            </button>
                            <button class="btn btn-sm rounded-pill px-3 fw-bold @(operationSubTab == "smartpaste" ? "btn-success" : "btn-outline-success")"
                                    @onclick='() => operationSubTab = "smartpaste"'>
                                <i class="bi bi-robot me-1"></i>4. AI SmartPaste Zalo
                            </button>
                            <button class="btn btn-sm rounded-pill px-3 fw-bold @(operationSubTab == "reports" ? "btn-success" : "btn-outline-success")"
                                    @onclick='() => operationSubTab = "reports"'>
                                <i class="bi bi-bar-chart-steps me-1"></i>5. Báo Cáo Công Suất Phòng
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        @if (operationSubTab == "rooms")
                        {
                            <KimLongEcoStay.Web.AdminPortal.Controls.RoomInspectionComponent />
                        }
                        else if (operationSubTab == "smartlock")
                        {
                            <KimLongEcoStay.Web.AdminPortal.Controls.SmartLockHubComponent />
                        }
                        else if (operationSubTab == "checkinout")
                        {
                            <KimLongEcoStay.Web.AdminPortal.Controls.ActiveBookingsComponent />
                        }
                        else if (operationSubTab == "smartpaste")
                        {
                            <KimLongEcoStay.Web.AdminPortal.Controls.SmartPasteModalComponent OnOrderCreated='() => operationSubTab = "checkinout"' />
                        }
                        else if (operationSubTab == "reports")
                        {
                            <KimLongEcoStay.Web.AdminPortal.Controls.OccupancyReportComponent />
                        }
                    </div>
                </div>
            }
            else if (mainTab == "sql-sync" && CanAccessModule("sql-sync"))
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 pb-3 border-bottom">
                        <div>
                            <h5 class="fw-bold mb-1" style="color: #14452F;">
                                <i class="bi bi-database-fill-check text-success me-2"></i>Trung Tâm Kết Nối &amp; Đồng Bộ Hai Chiều SQL Server (SignalR Real-Time)
                            </h5>
                            <div class="small text-muted">Chuỗi kết nối bảo mật: <code>@SqlSyncService.GetMaskedConnectionString()</code></div>
                        </div>
                        <div class="d-flex gap-2">
                            <span class="badge bg-success px-3 py-2 rounded-pill">
                                <i class="bi bi-check-circle-fill me-1"></i>SQL Server 2025 Connected
                            </span>
                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                <i class="bi bi-broadcast me-1"></i>SignalR Hub: /hubs/ecostay-sync (@KimLongEcoStay.Web.Services.EcoStaySyncHub.ConnectedClientsCount client)
                            </span>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="p-3 rounded-3 border bg-light">
                                <div class="small text-muted fw-bold">TRẠNG THÁI SQL SERVER</div>
                                <div class="fs-5 fw-bold text-success mt-1">ONLINE • 2-WAY</div>
                                <small class="text-muted">Change Tracking + DML Triggers</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 rounded-3 border bg-light">
                                <div class="small text-muted fw-bold">LƯỢT GHI SQL THÀNH CÔNG</div>
                                <div class="fs-5 fw-bold text-primary mt-1">@SqlSyncService.SuccessfulWrites</div>
                                <small class="text-muted">Thất bại: @SqlSyncService.FailedWrites</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 rounded-3 border bg-light">
                                <div class="small text-muted fw-bold">ĐỒNG BỘ LẦN CUỐI</div>
                                <div class="fs-6 fw-bold text-dark mt-1">@SqlSyncService.LastSyncTimestamp.ToLocalTime().ToString("HH:mm:ss dd/MM/yyyy")</div>
                                <small class="text-muted">Tự động qua SignalR 1.5s</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 rounded-3 border bg-light">
                                <div class="small text-muted fw-bold">TRỢ LÝ AI OPENAI</div>
                                <div class="fs-6 fw-bold text-success mt-1">GPT-4o-mini Ready</div>
                                <small class="text-muted">Grounded in SQL DB + RBAC</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <KimLongEcoStay.Web.AdminPortal.Controls.OutstandingOrdersComponent />
                </div>
            }
        </div>
    </div>
</div>

@code {
    public record AdminModuleMeta(string Id, string Title, string Icon, string Description);

    private static readonly Dictionary<string, AdminModuleMeta> AllCatalog = new()
    {
        ["reconciliation"] = new("reconciliation", "Đối Soát Cọc & Phòng", "bi-cash-coin", "Kiểm tra biên lai cọc 50% VietQR, duyệt phòng và cấp mã PIN SmartLock tự động"),
        ["specialties-admin"] = new("specialties-admin", "Sản Phẩm & Đặc Sản", "bi-basket2-fill", "Quản lý danh mục 30 đặc sản, tồn kho, giá bán và đơn đặt phục vụ buồng phòng"),
        ["partners-admin"] = new("partners-admin", "Đối Tác & Bản Đồ", "bi-geo-alt-fill", "Quản lý mạng lưới nhà vườn, làng nghề, quán ăn địa phương và tọa độ GPS bản đồ số"),
        ["tea-admin"] = new("tea-admin", "Trà Cung Đình", "bi-cup-hot-fill", "Quản lý gói trải nghiệm thưởng trà Cung Đình Huế và duyệt lịch đặt bàn trà"),
        ["emaillogs"] = new("emaillogs", "Nhật Ký Email & Giao Dịch", "bi-envelope-check-fill", "Theo dõi lịch sử tự động gửi 4 mẫu Email xác nhận đặt phòng, cọc và tất toán"),
        ["dashboard"] = new("dashboard", "Dashboard Tài Chính", "bi-bar-chart-line-fill", "Báo cáo doanh thu, chi phí vận hành, lợi nhuận ròng (EBITDA) và công suất phòng"),
        ["nhanvien"] = new("nhanvien", "Quản Lý Nhân Viên", "bi-people-fill", "Hồ sơ nhân sự, phân ca trực lễ tân - buồng phòng và đánh giá hiệu suất làm việc"),
        ["luong"] = new("luong", "Quản Lý Tiền Lương", "bi-wallet2", "Bảng tính lương, phụ cấp ca trực, thưởng KPI doanh thu và phiếu chi lương nhân sự"),
        ["duan"] = new("duan", "Vận Hành Dự Án / Phòng", "bi-buildings-fill", "Quản lý trạng thái 05 phòng sinh thái, Giao Phòng và Tra Cứu Khóa SmartLock IoT"),
        ["sql-sync"] = new("sql-sync", "Kết Nối & Đồng Bộ SQL", "bi-database-fill-gear", "Quản lý đồng bộ dữ liệu 2 chiều Website ↔ SQL Server, SignalR và Change Tracking")
    };

    [SupplyParameterFromQuery(Name = "tab")]
    public string? QueryTab { get; set; }

    private string mainTab = "reconciliation";
    private string operationSubTab = "rooms";
    private bool isSidebarCollapsed = false;
    private string? rbacNotice;

    private System.Security.Claims.ClaimsPrincipal? currentUser;

    private bool IsAdmin => currentUser != null && (currentUser.IsInRole("Admin") || currentUser.IsInRole("Administrator"));
    private bool IsAccountant => currentUser != null && currentUser.IsInRole("Accountant") && !IsAdmin;
    private bool IsHR => currentUser != null && (currentUser.IsInRole("HR") || currentUser.IsInRole("Manager")) && !IsAdmin;
    private bool IsReceptionist => currentUser != null && currentUser.IsInRole("Staff") && !IsAdmin && !IsAccountant && !IsHR;

    private List<string> GetAllowedModuleIds()
    {
        if (IsAdmin)
            return new() { "reconciliation", "specialties-admin", "partners-admin", "tea-admin", "emaillogs", "dashboard", "nhanvien", "luong", "duan", "sql-sync" };
        if (IsReceptionist)
            return new() { "reconciliation", "duan", "specialties-admin", "tea-admin", "emaillogs" };
        if (IsAccountant)
            return new() { "dashboard", "reconciliation", "luong", "emaillogs" };
        if (IsHR)
            return new() { "nhanvien", "duan", "partners-admin" };
        return new() { "reconciliation" };
    }

    private List<AdminModuleMeta> AllowedModules => GetAllowedModuleIds()
        .Where(id => AllCatalog.ContainsKey(id))
        .Select(id => AllCatalog[id])
        .ToList();

    private AdminModuleMeta CurrentModule => AllCatalog.TryGetValue(mainTab, out var meta) ? meta : AllCatalog["reconciliation"];

    private bool CanAccessModule(string modId) => GetAllowedModuleIds().Contains(modId);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUser = auth.User;
        mainTab = GetAllowedModuleIds().FirstOrDefault() ?? "reconciliation";
    }

    protected override void OnParametersSet()
    {
        var currentUri = NavManager.Uri.ToLowerInvariant();
        string? requested = null;
        if (currentUri.Contains("/dashboard")) requested = "dashboard";
        else if (currentUri.Contains("/nhanvien")) requested = "nhanvien";
        else if (currentUri.Contains("/luong")) requested = "luong";
        else if (currentUri.Contains("/duan")) requested = "duan";
        else if (!string.IsNullOrWhiteSpace(QueryTab)) requested = QueryTab.ToLowerInvariant();

        if (!string.IsNullOrEmpty(requested))
        {
            SwitchMainTab(requested);
        }
        else
        {
            EnsureValidTab();
        }
    }

    private void EnsureValidTab()
    {
        var allowed = GetAllowedModuleIds();
        if (!allowed.Contains(mainTab))
        {
            var first = allowed.FirstOrDefault() ?? "reconciliation";
            rbacNotice = $"Vai trò hiện tại không có quyền truy cập phân hệ '{mainTab}'. Đã chuyển về '{AllCatalog[first].Title}'.";
            mainTab = first;
        }
    }

    private void SwitchMainTab(string tab)
    {
        var allowed = GetAllowedModuleIds();
        if (!allowed.Contains(tab))
        {
            var first = allowed.FirstOrDefault() ?? "reconciliation";
            rbacNotice = $"Truy cập bị từ chối đối với phân hệ '{tab}'. Đã tự động chuyển về phân hệ hợp lệ đầu tiên: '{AllCatalog[first].Title}'.";
            mainTab = first;
        }
        else
        {
            rbacNotice = null;
            mainTab = tab;
        }
    }

    private void ToggleSidebar()
    {
        isSidebarCollapsed = !isSidebarCollapsed;
    }

    private string GetUserRole(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole("Admin") || user.IsInRole("Administrator")) return "👑 Admin (CEO)";
        if (user.IsInRole("Accountant")) return "💰 Kế Toán Trưởng";
        if (user.IsInRole("HR") || user.IsInRole("Manager")) return "📋 Nhân Sự / Vận Hành";
        if (user.IsInRole("Staff")) return "🛎️ Lễ Tân";
        return "Nhân Sự Nội Bộ";
    }
}
