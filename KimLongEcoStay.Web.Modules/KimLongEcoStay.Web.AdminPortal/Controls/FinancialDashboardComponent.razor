@inject IFinancialManagementUseCase FinancialUseCase
@inject IJSRuntime JSRuntime

<div class="financial-dashboard-container">
    <!-- Header Dashboard & Bộ Lọc Thời Gian Đồng Bộ -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h4 class="fw-bold text-dark mb-1 font-serif">
                <i class="bi bi-graph-up-arrow me-2 text-success"></i>Dashboard Tài Chính Kim Long EcoStay
            </h4>
            <p class="text-muted small mb-0">
                Bảng điều khiển trực quan theo dõi Doanh thu, Chi phí, Lợi nhuận và Dòng tiền nhà vườn sinh thái.
            </p>
        </div>

        <!-- Bộ Lọc Thời Gian -->
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="btn-group shadow-sm rounded-pill overflow-hidden border">
                <button class="btn btn-sm @(selectedFilterPeriod == "TODAY" ? "btn-success" : "btn-light")" 
                        @onclick='() => ChangePeriod("TODAY")'>Hôm nay</button>
                <button class="btn btn-sm @(selectedFilterPeriod == "LAST_7_DAYS" ? "btn-success" : "btn-light")" 
                        @onclick='() => ChangePeriod("LAST_7_DAYS")'>7 ngày</button>
                <button class="btn btn-sm @(selectedFilterPeriod == "THIS_MONTH" ? "btn-success" : "btn-light")" 
                        @onclick='() => ChangePeriod("THIS_MONTH")'>Tháng này</button>
                <button class="btn btn-sm @(selectedFilterPeriod == "LAST_MONTH" ? "btn-success" : "btn-light")" 
                        @onclick='() => ChangePeriod("LAST_MONTH")'>Tháng trước</button>
                <button class="btn btn-sm @(selectedFilterPeriod == "THIS_QUARTER" ? "btn-success" : "btn-light")" 
                        @onclick='() => ChangePeriod("THIS_QUARTER")'>Quý này</button>
                <button class="btn btn-sm @(selectedFilterPeriod == "THIS_YEAR" ? "btn-success" : "btn-light")" 
                        @onclick='() => ChangePeriod("THIS_YEAR")'>Năm nay</button>
            </div>

            <!-- Tùy chọn ngày -->
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="ToggleCustomDate">
                <i class="bi bi-calendar-range me-1"></i>Tùy chọn
            </button>
        </div>
    </div>

    <!-- Hàng chọn ngày tùy chọn nếu mở -->
    @if (showCustomDateRange)
    {
        <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-light">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <label class="small text-muted mb-1">Từ ngày:</label>
                    <input type="date" class="form-control form-control-sm" @bind="customFromDate" />
                </div>
                <div class="col-md-4">
                    <label class="small text-muted mb-1">Đến ngày:</label>
                    <input type="date" class="form-control form-control-sm" @bind="customToDate" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button class="btn btn-success btn-sm w-100 rounded-pill" @onclick='() => ChangePeriod("CUSTOM")'>
                        <i class="bi bi-check-circle me-1"></i>Áp Dụng Khoảng Ngày
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- 8 THẺ KPI TÀI CHÍNH CHUẨN ĐỀ BÀI -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-success" role="status"></div>
            <p class="text-muted mt-2">Đang tổng hợp dữ liệu tài chính...</p>
        </div>
    }
    else if (dashboardData != null)
    {
        var kpi = dashboardData.KPI;
        decimal combinedFlow = kpi.TotalRevenue + kpi.TotalExpense;
        decimal revenueRatio = combinedFlow > 0 ? (kpi.TotalRevenue * 100 / combinedFlow) : 50;
        decimal expenseRatio = 100 - revenueRatio;

        <!-- 8 THẺ KPI TÀI CHÍNH TRỰC QUAN HÓA CAO CẤP -->
        <div class="row g-3 mb-3">
            <!-- 1. Tổng doanh thu -->
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-success">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">1. Tổng Doanh Thu</span>
                            <div class="d-flex align-items-baseline gap-2 mt-1">
                                <h3 class="fw-bold text-success mb-0 font-numeric">@kpi.TotalRevenue.ToString("N0") đ</h3>
                            </div>
                        </div>
                        <div class="rounded-circle p-2 bg-success bg-opacity-10 text-success">
                            <i class="bi bi-graph-up-arrow fs-5"></i>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-success-subtle text-success border border-success fw-bold kpi-compact-badge">
                            <i class="bi bi-cash-stack"></i>~ @FormatCompactMoney(kpi.TotalRevenue) VNĐ
                        </span>
                        <small class="text-muted">Thực thu: <strong class="text-dark font-numeric">@FormatCompactMoney(kpi.ActualCashCollected)</strong></small>
                    </div>
                </div>
            </div>

            <!-- 2. Tổng chi phí -->
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-danger">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">2. Tổng Chi Phí</span>
                            <div class="d-flex align-items-baseline gap-2 mt-1">
                                <h3 class="fw-bold text-danger mb-0 font-numeric">@kpi.TotalExpense.ToString("N0") đ</h3>
                            </div>
                        </div>
                        <div class="rounded-circle p-2 bg-danger bg-opacity-10 text-danger">
                            <i class="bi bi-wallet2 fs-5"></i>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-danger-subtle text-danger border border-danger fw-bold kpi-compact-badge">
                            <i class="bi bi-arrow-down-right"></i>~ @FormatCompactMoney(kpi.TotalExpense) VNĐ
                        </span>
                        <small class="text-muted">Thực chi: <strong class="text-dark font-numeric">@FormatCompactMoney(kpi.ActualCashPaid)</strong></small>
                    </div>
                </div>
            </div>

            <!-- 3. Lợi nhuận tạm tính -->
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 @(kpi.EstimatedProfit >= 0 ? "border-primary" : "border-warning")">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">3. Lợi Nhuận Tạm Tính</span>
                            <div class="d-flex align-items-baseline gap-2 mt-1">
                                <h3 class="fw-bold @(kpi.EstimatedProfit >= 0 ? "text-primary" : "text-warning") mb-0 font-numeric">
                                    @kpi.EstimatedProfit.ToString("N0") đ
                                </h3>
                            </div>
                        </div>
                        <div class="rounded-circle p-2 bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-trophy-fill fs-5"></i>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-primary-subtle text-primary border border-primary fw-bold kpi-compact-badge">
                            <i class="bi bi-gem"></i>~ @FormatCompactMoney(kpi.EstimatedProfit) VNĐ
                        </span>
                        <small class="text-muted">Doanh thu - Chi phí</small>
                    </div>
                </div>
            </div>

            <!-- 4. Tỷ suất lợi nhuận -->
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-warning">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">4. Tỷ Suất Lợi Nhuận</span>
                            <div class="d-flex align-items-baseline gap-2 mt-1">
                                <h3 class="fw-bold text-warning mb-0 font-numeric">
                                    @(kpi.TotalRevenue > 0 ? $"{kpi.ProfitMargin:F1}%" : "0.0%")
                                </h3>
                            </div>
                        </div>
                        <div class="rounded-circle p-2 bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-pie-chart-fill fs-5"></i>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning fw-bold kpi-compact-badge">
                            <i class="bi bi-percent"></i>Biên Lãi Ròng
                        </span>
                        <small class="text-muted">@(kpi.ProfitMargin >= 20 ? "Hiệu quả cao" : "Mức tiêu chuẩn")</small>
                    </div>
                </div>
            </div>

            <!-- 5. Doanh thu tháng hiện tại -->
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-info">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">5. Doanh Thu Tháng Này</span>
                            <h4 class="fw-bold text-info mb-0 mt-1 font-numeric">@kpi.CurrentMonthRevenue.ToString("N0") đ</h4>
                        </div>
                        <div class="rounded-circle p-2 bg-info bg-opacity-10 text-info">
                            <i class="bi bi-calendar-check fs-5"></i>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-info-subtle text-info border border-info fw-bold kpi-compact-badge">
                            ~ @FormatCompactMoney(kpi.CurrentMonthRevenue)
                        </span>
                        <small class="text-muted">Tháng @DateTime.Today.Month/@DateTime.Today.Year</small>
                    </div>
                </div>
            </div>

            <!-- 6. Chi phí tháng hiện tại -->
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-secondary">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">6. Chi Phí Tháng Này</span>
                            <h4 class="fw-bold text-dark mb-0 mt-1 font-numeric">@kpi.CurrentMonthExpense.ToString("N0") đ</h4>
                        </div>
                        <div class="rounded-circle p-2 bg-secondary bg-opacity-10 text-dark">
                            <i class="bi bi-receipt fs-5"></i>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-secondary-subtle text-dark border fw-bold kpi-compact-badge">
                            ~ @FormatCompactMoney(kpi.CurrentMonthExpense)
                        </span>
                        <small class="text-muted">Bao gồm lương & vận hành</small>
                    </div>
                </div>
            </div>

            <!-- 7. Số giao dịch thu -->
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-success">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">7. Số Giao Dịch Thu</span>
                            <h4 class="fw-bold text-success mb-0 mt-1 font-numeric">@kpi.IncomeTransactionCount đơn thu</h4>
                        </div>
                        <div class="rounded-circle p-2 bg-success bg-opacity-10 text-success">
                            <i class="bi bi-arrow-down-left-circle-fill fs-5"></i>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-light text-success border fw-semibold kpi-compact-badge">
                            <i class="bi bi-check2-all"></i>Đặt phòng & Trải nghiệm
                        </span>
                        <small class="text-muted">Dòng tiền vào</small>
                    </div>
                </div>
            </div>

            <!-- 8. Số giao dịch chi -->
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-danger">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">8. Số Giao Dịch Chi</span>
                            <h4 class="fw-bold text-danger mb-0 mt-1 font-numeric">@kpi.ExpenseTransactionCount phiếu chi</h4>
                        </div>
                        <div class="rounded-circle p-2 bg-danger bg-opacity-10 text-danger">
                            <i class="bi bi-arrow-up-right-circle-fill fs-5"></i>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-light text-danger border fw-semibold kpi-compact-badge">
                            <i class="bi bi-journal-check"></i>Đã duyệt & Đã chi
                        </span>
                        <small class="text-muted">Dòng tiền ra</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- THƯỚC ĐO CÂN ĐỐI TÀI CHÍNH TOÀN DIỆN (TỔNG THỂ TRỰC QUAN THAY VÌ CHỈ CÓ SỐ) -->
        <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-speedometer2 text-success fs-5"></i>
                    <strong class="text-dark font-serif">Cân Đối Sức Khỏe Tài Chính Tổng Thể:</strong>
                    <span class="badge @(kpi.EstimatedProfit >= 0 ? "bg-success" : "bg-danger") rounded-pill px-3 py-1">
                        @(kpi.EstimatedProfit >= 0 ? "Dòng tiền thặng dư - Tăng trưởng tốt" : "Cần kiểm soát chi phí")
                    </span>
                </div>
                <div class="small text-muted d-flex gap-3">
                    <span><i class="bi bi-circle-fill text-success me-1"></i>Doanh thu: <strong>@revenueRatio.ToString("F1")%</strong> (~@FormatCompactMoney(kpi.TotalRevenue))</span>
                    <span><i class="bi bi-circle-fill text-danger me-1"></i>Chi phí: <strong>@expenseRatio.ToString("F1")%</strong> (~@FormatCompactMoney(kpi.TotalExpense))</span>
                    <span><i class="bi bi-star-fill text-warning me-1"></i>Tỷ suất lãi: <strong>@(kpi.TotalRevenue > 0 ? $"{kpi.ProfitMargin:F1}%" : "0%")</strong></span>
                </div>
            </div>
            <!-- Thanh đo trực quan 2 màu tương quan Doanh thu vs Chi phí -->
            <div class="progress" style="height: 14px; border-radius: 999px; background-color: #f1f5f9; box-shadow: inset 0 1px 2px rgba(0,0,0,0.06);">
                <div class="progress-bar bg-success" role="progressbar" style="width: @revenueRatio%" 
                     title="Doanh thu: @revenueRatio.ToString("F1")%"></div>
                <div class="progress-bar bg-danger" role="progressbar" style="width: @expenseRatio%" 
                     title="Chi phí: @expenseRatio.ToString("F1")%"></div>
            </div>
        </div>

        <!-- TABS ĐIỀU HƯỚNG TÀI CHÍNH -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom p-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <ul class="nav nav-pills gap-2">
                        <li class="nav-item">
                            <button class="nav-link rounded-pill px-4 @(activeTab == "charts" ? "active bg-success text-white fw-bold shadow-sm" : "text-muted")"
                                    @onclick='() => SetActiveTab("charts")'>
                                <i class="bi bi-bar-chart-line-fill me-1"></i>Biểu Đồ Trực Quan & Phân Tích
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link rounded-pill px-4 @(activeTab == "revenues" ? "active bg-success text-white fw-bold shadow-sm" : "text-muted")"
                                    @onclick='() => SetActiveTab("revenues")'>
                                <i class="bi bi-cash-coin me-1"></i>Sổ Doanh Thu (@transactions.Count)
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link rounded-pill px-4 @(activeTab == "expenses" ? "active bg-success text-white fw-bold shadow-sm" : "text-muted")"
                                    @onclick='() => SetActiveTab("expenses")'>
                                <i class="bi bi-journal-text me-1"></i>Sổ Chi Phí & Phiếu Chi (@expenses.Count)
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link rounded-pill px-4 @(activeTab == "debt" ? "active bg-success text-white fw-bold shadow-sm" : "text-muted")"
                                    @onclick='() => SetActiveTab("debt")'>
                                <i class="bi bi-arrow-left-right me-1"></i>Đối Soát & Dòng Tiền
                            </button>
                        </li>
                    </ul>

                    @if (activeTab == "expenses")
                    {
                        <button class="btn btn-danger rounded-pill px-3 shadow-sm fw-semibold" @onclick="OpenAddExpenseModal">
                            <i class="bi bi-plus-lg me-1"></i>Tạo Phiếu Chi Mới
                        </button>
                    }
                </div>
            </div>

            <div class="card-body p-4">
                <!-- TAB 1: BIỂU ĐỒ & PHÂN TÍCH (ĐỒ THỊ TRỰC QUAN CAO CẤP) -->
                @if (activeTab == "charts")
                {
                    <div class="row g-4 mb-4">
                        <!-- Biểu đồ 1: Biến động Doanh thu vs Chi phí theo thời gian (Combo Bar & Line) -->
                        <div class="col-lg-8">
                            <div class="card border rounded-4 shadow-sm h-100 p-4 bg-white">
                                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                    <div>
                                        <h6 class="fw-bold text-dark font-serif mb-1">
                                            <i class="bi bi-bar-chart-fill me-2 text-success"></i>Biến Động Doanh Thu & Chi Phí Theo Dòng Thời Gian
                                        </h6>
                                        <small class="text-muted">Cột Xanh: Doanh thu | Cột Đỏ: Chi phí | Đường Vàng: Lợi nhuận ròng</small>
                                    </div>
                                    <span class="badge bg-light text-dark border px-3 py-2">
                                        <i class="bi bi-clock-history me-1"></i>Kỳ: @selectedFilterPeriod
                                    </span>
                                </div>

                                <!-- Canvas Chart.js Biểu Đồ Cột & Đường -->
                                <div style="position: relative; height: 320px; width: 100%;">
                                    <canvas id="financialTimelineChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Biểu đồ 2: Cơ Cấu Chi Phí Theo Danh Mục (Doughnut Chart) -->
                        <div class="col-lg-4">
                            <div class="card border rounded-4 shadow-sm h-100 p-4 bg-white">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-dark font-serif mb-0">
                                        <i class="bi bi-pie-chart-fill me-2 text-danger"></i>Cơ Cấu Chi Phí
                                    </h6>
                                    <span class="badge bg-danger-subtle text-danger border border-danger">@dashboardData.ExpenseBreakdown.Count nhóm</span>
                                </div>
                                <small class="text-muted d-block mb-3">Tỷ trọng các khoản chi vận hành homestay</small>

                                <!-- Canvas Doughnut Chart -->
                                <div style="position: relative; height: 210px; width: 100%; margin-bottom: 12px;">
                                    <canvas id="expenseBreakdownChart"></canvas>
                                </div>

                                <!-- Danh sách tóm tắt tỷ trọng -->
                                <div class="expense-breakdown-list mt-2" style="max-height: 140px; overflow-y: auto;">
                                    @foreach (var cat in dashboardData.ExpenseBreakdown)
                                    {
                                        <div class="d-flex justify-content-between align-items-center small py-1 border-bottom border-light">
                                            <span class="text-dark fw-semibold">
                                                <span style="color: @cat.ColorHex;">●</span> @cat.CategoryName
                                            </span>
                                            <span class="text-danger fw-bold font-numeric">
                                                @FormatCompactMoney(cat.Amount) (@cat.Percentage%)
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <!-- Biểu đồ 3: Cơ Cấu Doanh Thu Theo Nguồn Dịch Vụ (Doughnut Chart) -->
                        <div class="col-lg-6">
                            <div class="card border rounded-4 shadow-sm h-100 p-4 bg-white">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-dark font-serif mb-0">
                                        <i class="bi bi-diagram-2-fill me-2 text-primary"></i>Cơ Cấu Nguồn Doanh Thu
                                    </h6>
                                    <span class="badge bg-primary-subtle text-primary border border-primary">@dashboardData.RevenueSources.Count nguồn</span>
                                </div>
                                <small class="text-muted d-block mb-3">Phân bổ nguồn thu giữa Tiền phòng, Ẩm thực & Tour di sản</small>

                                <div class="row align-items-center">
                                    <div class="col-sm-6">
                                        <div style="position: relative; height: 210px; width: 100%;">
                                            <canvas id="revenueSourcesChart"></canvas>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="revenue-sources-list">
                                            @foreach (var src in dashboardData.RevenueSources)
                                            {
                                                <div class="mb-3">
                                                    <div class="d-flex justify-content-between small mb-1">
                                                        <span class="fw-semibold text-dark">
                                                            <span style="color: @src.ColorHex;">●</span> @src.SourceName
                                                        </span>
                                                        <span class="fw-bold text-success font-numeric">@src.Percentage%</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div class="progress flex-grow-1 me-2" style="height: 6px; background-color: #f1f5f9;">
                                                            <div class="progress-bar" role="progressbar" 
                                                                 style="width: @src.Percentage%; background-color: @src.ColorHex;"></div>
                                                        </div>
                                                        <span class="small text-muted font-numeric">@FormatCompactMoney(src.Amount)</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Bảng Giao Dịch Thu Chi Gần Đây -->
                        <div class="col-lg-6">
                            <div class="card border rounded-4 shadow-sm h-100 p-4 bg-white">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-bold text-dark font-serif mb-0">
                                        <i class="bi bi-clock-history me-2 text-warning"></i>Giao Dịch Gần Đây Nhất
                                    </h6>
                                    <span class="badge bg-light text-dark border">@dashboardData.RecentTransactions.Count giao dịch</span>
                                </div>
                                <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead class="table-light small sticky-top">
                                            <tr>
                                                <th>Thời Gian</th>
                                                <th>Khoản Mục</th>
                                                <th>Phương Thức</th>
                                                <th class="text-end">Số Tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var tx in dashboardData.RecentTransactions)
                                            {
                                                <tr>
                                                    <td class="small text-muted font-numeric">@tx.TransactionDate.ToString("dd/MM HH:mm")</td>
                                                    <td>
                                                        <div class="fw-semibold small text-dark">@tx.Category</div>
                                                        <div class="text-muted" style="font-size: 11px;">@tx.Description</div>
                                                    </td>
                                                    <td><span class="badge bg-light text-dark border">@tx.PaymentMethod</span></td>
                                                    <td class="text-end fw-bold font-numeric @(tx.Type == "INCOME" ? "text-success" : "text-danger")">
                                                        @(tx.Type == "INCOME" ? "+" : "-")@tx.Amount.ToString("N0") đ
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (activeTab == "revenues")
                {
                    <!-- TAB 2: SỔ DOANH THU -->
                    <div class="table-responsive rounded-3 border">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã Giao Dịch</th>
                                    <th>Thời Gian</th>
                                    <th>Nguồn Doanh Thu</th>
                                    <th>Nội Dung Chi Tiết</th>
                                    <th>Phương Thức</th>
                                    <th>Người Ghi Nhận</th>
                                    <th class="text-end">Số Tiền (VNĐ)</th>
                                    <th class="text-center">Trạng Thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tx in transactions.Where(t => t.Type == "INCOME"))
                                {
                                    <tr>
                                        <td><span class="font-monospace fw-bold text-primary small">@tx.TransactionCode</span></td>
                                        <td>@tx.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                             <span class="badge bg-success-subtle text-success border border-success">
                                                @tx.SourceType
                                            </span>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark">@tx.Category</div>
                                            <small class="text-muted">@tx.Description</small>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@tx.PaymentMethod</span></td>
                                        <td class="small text-muted">@tx.CreatedBy</td>
                                        <td class="text-end fw-bold text-success fs-6">
                                            + @tx.Amount.ToString("N0") đ
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-success">Đã thu</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (activeTab == "expenses")
                {
                    <!-- TAB 3: SỔ CHI PHÍ & PHIẾU CHI -->
                    <div class="table-responsive rounded-3 border">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã Phiếu Chi</th>
                                    <th>Ngày Chi</th>
                                    <th>Danh Mục Chi</th>
                                    <th>Nội Dung Chi Phí</th>
                                    <th>Đơn Vị / Người Nhận</th>
                                    <th>Hình Thức</th>
                                    <th class="text-end">Số Tiền (VNĐ)</th>
                                    <th class="text-center">Trạng Thái</th>
                                    <th class="text-end" style="width: 100px;">Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var exp in expenses)
                                {
                                    <tr>
                                        <td><span class="font-monospace fw-bold text-danger small">@exp.VoucherCode</span></td>
                                        <td>@exp.ExpenseDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <span class="badge text-white" style="background-color: @(exp.ColorHex ?? "#10B981")">
                                                @exp.CategoryName
                                            </span>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark">@exp.Title</div>
                                            <small class="text-muted">@exp.Notes</small>
                                        </td>
                                        <td><div class="fw-medium text-dark">@exp.PayeeName</div></td>
                                        <td><span class="badge bg-light text-dark border">@exp.PaymentMethod</span></td>
                                        <td class="text-end fw-bold text-danger fs-6">
                                            - @exp.Amount.ToString("N0") đ
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @exp.StatusBadgeClass">@exp.StatusDisplay</span>
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-outline-danger btn-sm" title="Xóa phiếu chi" @onclick="() => DeleteExpense(exp.Id)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (activeTab == "debt")
                {
                    <!-- TAB 4: ĐỐI SOÁT & CÔNG NỢ -->
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="card border rounded-4 shadow-sm p-4 bg-white h-100">
                                <h6 class="fw-bold text-primary font-serif mb-3">
                                    <i class="bi bi-box-arrow-in-down-right me-2 text-success"></i>Khoản Phải Thu (Receivables)
                                </h6>
                                <p class="text-muted small">
                                    Các khoản tiền phòng còn lại (50%) khách lưu trú sẽ thanh toán khi làm thủ tục check-in hoặc check-out tại homestay.
                                </p>
                                <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center mb-3">
                                    <span class="fw-bold text-dark">Tổng tiền phòng chờ thu:</span>
                                    <span class="fs-4 fw-bold text-success">@dashboardData.KPI.TotalReceivables.ToString("N0") đ</span>
                                </div>
                                <div class="alert alert-info py-2 small mb-0">
                                    <i class="bi bi-info-circle me-1"></i>Hệ thống tự động kích hoạt mã thanh toán VietQR cho số tiền này trên giao diện Tiếp Đón Khách Check-in.
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card border rounded-4 shadow-sm p-4 bg-white h-100">
                                <h6 class="fw-bold text-danger font-serif mb-3">
                                    <i class="bi bi-box-arrow-up-right me-2 text-danger"></i>Khoản Phải Trả (Payables)
                                </h6>
                                <p class="text-muted small">
                                    Các khoản chi phí vận hành, bảo trì hoặc tiền lương đã được phê duyệt nhưng chưa hoàn tất giải ngân.
                                </p>
                                <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center mb-3">
                                    <span class="fw-bold text-dark">Tổng chi phí đang chờ thanh toán:</span>
                                    <span class="fs-4 fw-bold text-danger">@dashboardData.KPI.TotalPayables.ToString("N0") đ</span>
                                </div>
                                <div class="alert alert-warning py-2 small mb-0">
                                    <i class="bi bi-shield-lock me-1"></i>Chỉ Kế Toán Trưởng và Ban Điều Hành mới có quyền bấm phê duyệt lệnh chi trả trên hệ thống.
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- MODAL TẠO PHIẾU CHI MỚI -->
@if (isAddExpenseModalOpen && newExpense != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(10, 61, 44, 0.65); backdrop-filter: blur(4px); z-index: 1055;">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header text-white px-4 py-3" style="background: linear-gradient(135deg, #7F1D1D 0%, #991B1B 100%);">
                    <h5 class="modal-title fw-bold mb-0">
                        <i class="bi bi-receipt me-2 text-warning"></i>LẬP PHIẾU CHI PHÍ MỚI
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isAddExpenseModalOpen = false"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    @if (!string.IsNullOrEmpty(expenseErrorMessage))
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>@expenseErrorMessage
                        </div>
                    }

                    <div class="card border-0 rounded-3 p-4 bg-white shadow-sm">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Mã Phiếu Chi</label>
                                <input type="text" class="form-control font-monospace" @bind="newExpense.VoucherCode" placeholder="PC-202610-..." />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Ngày Phát Sinh</label>
                                <input type="date" class="form-control" @bind="newExpense.ExpenseDate" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Danh Mục Chi <span class="text-danger">*</span></label>
                                <select class="form-select" @bind="newExpense.CategoryId">
                                    @foreach (var c in categories)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-semibold">Nội Dung Chi Phí <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" @bind="newExpense.Title" required placeholder="Ví dụ: Mua vật tư tinh dầu và xà phòng bồ hòn..." />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold text-danger">Số Tiền (VNĐ) <span class="text-danger">*</span></label>
                                <input type="number" step="10000" min="1000" class="form-control fw-bold text-danger" @bind="newExpense.Amount" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Người / Đơn Vị Nhận Tiền <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" @bind="newExpense.PayeeName" required placeholder="Công ty / Cửa hàng / Nhân viên..." />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Phương Thức Thanh Toán</label>
                                <select class="form-select" @bind="newExpense.PaymentMethod">
                                    <option value="Chuyển khoản">Chuyển khoản ngân hàng</option>
                                    <option value="VietQR">Quét mã VietQR</option>
                                    <option value="Tiền mặt">Tiền mặt tại quầy</option>
                                    <option value="Thẻ tín dụng">Thẻ tín dụng công ty</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Người Lập Phiếu</label>
                                <input type="text" class="form-control" @bind="newExpense.CreatedBy" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Trạng Thái Chi Trả</label>
                                <select class="form-select" @bind="newExpense.Status">
                                    <option value="PAID">Đã thanh toán (Thực chi)</option>
                                    <option value="PENDING">Chờ thanh toán (Phải trả)</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Ghi Chú & Số Chứng Từ / Hóa Đơn</label>
                                <textarea class="form-control" rows="2" @bind="newExpense.Notes" placeholder="Hóa đơn VAT, số hợp đồng hoặc ghi chú đối soát..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-white px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="() => isAddExpenseModalOpen = false">
                        Hủy
                    </button>
                    <button type="button" class="btn btn-danger rounded-pill px-5 fw-bold shadow-sm" @onclick="SaveExpense">
                        <i class="bi bi-save me-1"></i>Lưu Phiếu Chi
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private string selectedFilterPeriod = "THIS_MONTH";
    private string activeTab = "charts";

    private bool showCustomDateRange = false;
    private DateTime customFromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime customToDate = DateTime.Today;

    private FinancialDashboardData? dashboardData;
    private List<Expense> expenses = new();
    private List<FinancialTransaction> transactions = new();
    private List<ExpenseCategory> categories = new();

    // Modal Phiếu Chi
    private bool isAddExpenseModalOpen = false;
    private Expense? newExpense;
    private string expenseErrorMessage = "";

    private string FormatCompactMoney(decimal amount)
    {
        decimal abs = Math.Abs(amount);
        if (abs >= 1_000_000_000)
        {
            return $"{(amount / 1_000_000_000m):F2} Tỷ";
        }
        if (abs >= 1_000_000)
        {
            return $"{(amount / 1_000_000m):F1} Tr";
        }
        if (abs >= 1_000)
        {
            return $"{(amount / 1_000m):F0} k";
        }
        return $"{amount:N0} đ";
    }

    private async Task SetActiveTab(string tab)
    {
        activeTab = tab;
        if (tab == "charts")
        {
            StateHasChanged();
            await Task.Delay(100);
            await RenderChartsAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && activeTab == "charts" && dashboardData != null)
        {
            await RenderChartsAsync();
        }
    }

    private async Task RenderChartsAsync()
    {
        try
        {
            if (dashboardData == null) return;

            // 1. Timeline Chart
            var labels = dashboardData.Timeline.Select(t => t.Label).ToArray();
            var revenues = dashboardData.Timeline.Select(t => t.Revenue).ToArray();
            var expenses = dashboardData.Timeline.Select(t => t.Expense).ToArray();
            var profits = dashboardData.Timeline.Select(t => t.Profit).ToArray();
            await JSRuntime.InvokeVoidAsync("financialCharts.renderTimelineChart", "financialTimelineChart", labels, revenues, expenses, profits);

            // 2. Expense Donut Chart
            var expLabels = dashboardData.ExpenseBreakdown.Select(e => e.CategoryName).ToArray();
            var expData = dashboardData.ExpenseBreakdown.Select(e => e.Amount).ToArray();
            var expColors = dashboardData.ExpenseBreakdown.Select(e => e.ColorHex).ToArray();
            await JSRuntime.InvokeVoidAsync("financialCharts.renderExpenseDonutChart", "expenseBreakdownChart", expLabels, expData, expColors);

            // 3. Revenue Donut Chart
            var revLabels = dashboardData.RevenueSources.Select(r => r.SourceName).ToArray();
            var revData = dashboardData.RevenueSources.Select(r => r.Amount).ToArray();
            var revColors = dashboardData.RevenueSources.Select(r => r.ColorHex).ToArray();
            await JSRuntime.InvokeVoidAsync("financialCharts.renderRevenueDonutChart", "revenueSourcesChart", revLabels, revData, revColors);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering charts: {ex.Message}");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            categories = (await FinancialUseCase.GetExpenseCategoriesAsync()).ToList();
            dashboardData = await FinancialUseCase.GetDashboardDataAsync(
                filterPeriod: selectedFilterPeriod,
                customFrom: customFromDate,
                customTo: customToDate
            );
            expenses = (await FinancialUseCase.GetExpensesAsync(
                fromDate: dashboardData.FromDate,
                toDate: dashboardData.ToDate
            )).ToList();
            transactions = (await FinancialUseCase.GetTransactionsAsync(
                fromDate: dashboardData.FromDate,
                toDate: dashboardData.ToDate
            )).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading financial dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangePeriod(string period)
    {
        selectedFilterPeriod = period;
        if (period != "CUSTOM")
        {
            showCustomDateRange = false;
        }
        await LoadData();
    }

    private void ToggleCustomDate()
    {
        showCustomDateRange = !showCustomDateRange;
    }

    private void OpenAddExpenseModal()
    {
        newExpense = new Expense
        {
            VoucherCode = $"PC-{DateTime.Today:yyyyMM}-{(new Random().Next(100, 999))}",
            ExpenseDate = DateTime.Today,
            CategoryId = categories.FirstOrDefault()?.Id ?? 1,
            Amount = 500000,
            PaymentMethod = "Chuyển khoản",
            Status = "PAID",
            CreatedBy = "Trần Minh Khoa (Kế toán)"
        };
        expenseErrorMessage = "";
        isAddExpenseModalOpen = true;
    }

    private async Task SaveExpense()
    {
        if (newExpense == null) return;
        expenseErrorMessage = "";

        if (string.IsNullOrWhiteSpace(newExpense.Title))
        {
            expenseErrorMessage = "Vui lòng nhập nội dung chi phí.";
            return;
        }
        if (newExpense.Amount <= 0)
        {
            expenseErrorMessage = "Số tiền chi phí phải lớn hơn 0.";
            return;
        }
        if (string.IsNullOrWhiteSpace(newExpense.PayeeName))
        {
            expenseErrorMessage = "Vui lòng nhập đơn vị hoặc người nhận tiền.";
            return;
        }

        try
        {
            await FinancialUseCase.AddExpenseAsync(newExpense);
            isAddExpenseModalOpen = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            expenseErrorMessage = $"Lỗi khi lưu phiếu chi: {ex.Message}";
        }
    }

    private async Task DeleteExpense(int id)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa phiếu chi này không?");
        if (confirmed)
        {
            await FinancialUseCase.DeleteExpenseAsync(id);
            await LoadData();
        }
    }
}
