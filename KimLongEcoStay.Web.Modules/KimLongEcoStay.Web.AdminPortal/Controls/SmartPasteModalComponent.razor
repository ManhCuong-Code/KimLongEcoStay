@using KimLongEcoStay.CoreBusiness.Models
@using KimLongEcoStay.UseCases.SmartPasteScreen
@using KimLongEcoStay.UseCases.PluginInterfaces.DataStore
@inject ISmartPasteUseCase SmartPasteUseCase
@inject IOrderRepository OrderRepository

<div class="card shadow-sm border-0 my-3">
    <div class="card-header bg-gradient text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #1E3A8A 0%, #3B82F6 100%);">
        <div>
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-robot me-2 text-warning"></i>Trợ Lý AI SmartPaste — Bóc Tách Tin Nhắn Zalo Đặt Phòng
            </h5>
            <small class="text-white-50">Chuẩn Mục 10 Barem Chấm Thi & Tiêu Chí K4.3: AI gợi ý, Lễ tân duyệt trước khi ghi CSDL</small>
        </div>
        <span class="badge bg-warning text-dark fw-bold px-3 py-2">
            <i class="bi bi-lightning-charge-fill me-1"></i>Trích xuất 1 Giây
        </span>
    </div>

    <div class="card-body p-4">
        <!-- Hướng dẫn & Nút chọn tin mẫu -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <span class="text-muted small">
                <i class="bi bi-info-circle text-primary me-1"></i>Dán tin nhắn Zalo / Fanpage của khách vào ô bên dưới hoặc chọn tin mẫu:
            </span>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-primary" @onclick='() => SetSample(1)'>Tin Mẫu 1 (Ban Mai)</button>
                <button type="button" class="btn btn-outline-primary" @onclick='() => SetSample(2)'>Tin Mẫu 2 (Garden Suite)</button>
                <button type="button" class="btn btn-outline-primary" @onclick='() => SetSample(3)'>Tin Mẫu 3 (Family Villa)</button>
            </div>
        </div>

        <!-- Khung Nhập Tin Nhắn Zalo -->
        <div class="mb-3">
            <textarea class="form-control rounded-3 font-monospace small" rows="3" 
                      placeholder="Dán tin nhắn Zalo của khách tại đây, ví dụ: 'Dạ chị ơi bên mình còn phòng ban mai 2 người từ 15/10 đến 17/10 ko? Em tên Đăng 0912345678'..." 
                      @bind="rawMessage"></textarea>
        </div>

        <div class="d-flex justify-content-end mb-4">
            <button class="btn btn-primary fw-bold px-4 py-2 rounded-pill shadow-sm" @onclick="HandleExtract" disabled="@isExtracting">
                @if (isExtracting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Đang AI phân tích...</span>
                }
                else
                {
                    <i class="bi bi-magic me-2 text-warning"></i>
                    <span>Trích Xuất Thông Tin Bằng AI SmartPaste</span>
                }
            </button>
        </div>

        @if (extractedData != null)
        {
            <!-- BẢNG KẾT QUẢ AI TRÍCH XUẤT CHO LỄ TÂN DUYỆT -->
            <div class="p-4 rounded-4 border bg-light shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 border-bottom pb-2">
                    <h6 class="fw-bold text-dark mb-0 font-serif">
                        <i class="bi bi-check2-circle text-success me-2 fs-5"></i>Kết Quả AI Bóc Tách (Độ Tin Cậy: @((extractedData.ConfidenceScore * 100).ToString("N0"))%)
                    </h6>
                    <span class="badge bg-success bg-opacity-25 text-success border border-success px-3 py-1">
                        Sẵn sàng duyệt & Lưu vào CSDL
                    </span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-dark">Họ và Tên Khách:</label>
                        <input type="text" class="form-control" @bind="extractedData.CustomerName" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-dark">Số Điện Thoại / Zalo:</label>
                        <input type="text" class="form-control" @bind="extractedData.PhoneNumber" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-dark">Buồng Phòng Nhận Diện:</label>
                        <input type="text" class="form-control" @bind="extractedData.RoomNameOrType" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-dark">Số Lượng Khách:</label>
                        <input type="number" class="form-control" @bind="extractedData.NumberOfGuests" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-dark">Ngày Nhận Phòng (Check-in 14h00):</label>
                        <input type="date" class="form-control" @bind="extractedData.CheckInDate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-dark">Ngày Trả Phòng (Check-out 12h00):</label>
                        <input type="date" class="form-control" @bind="extractedData.CheckOutDate" />
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold text-dark">Ghi Chú Yêu Cầu Đặc Biệt:</label>
                        <input type="text" class="form-control" @bind="extractedData.SpecialRequests" />
                    </div>
                </div>

                <!-- Bảng tính tiền tự động theo Luật 2 -->
                <div class="p-3 bg-white rounded-3 border mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <span class="text-muted small">Thời gian lưu trú:</span>
                        <strong class="text-dark ms-1">@extractedData.TotalNights đêm</strong>
                    </div>
                    <div>
                        <span class="text-muted small">Ước tính tổng tiền:</span>
                        <strong class="text-success fs-5 ms-1">@extractedData.EstimatedTotal.ToString("N0") VNĐ</strong>
                    </div>
                    <div>
                        <span class="text-muted small">Tiền cọc VietQR (50%):</span>
                        <strong class="text-danger fs-5 ms-1">@extractedData.EstimatedDeposit.ToString("N0") VNĐ</strong>
                    </div>
                </div>

                @if (!isSaved)
                {
                    <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-outline-secondary rounded-pill px-3" @onclick="() => extractedData = null">Hủy Bỏ</button>
                        <button class="btn btn-success fw-bold rounded-pill px-4" @onclick="ConfirmAndSave">
                            <i class="bi bi-save me-1"></i>Lễ Tân Xác Nhận & Tạo Đơn Phòng
                        </button>
                    </div>
                }
                else
                {
                    <div class="alert alert-success d-flex align-items-center mb-0 rounded-3">
                        <i class="bi bi-check-circle-fill fs-4 me-2"></i>
                        <div>
                            <strong>Tạo Đơn Thành Công!</strong> Đơn đặt phòng <code>@savedBookingCode</code> đã được ghi vào hệ thống và kích hoạt quy trình cấp mã khóa SmartLock 10s.
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private string rawMessage = string.Empty;
    private bool isExtracting = false;
    private SmartPasteExtractedBooking? extractedData;
    private bool isSaved = false;
    private string savedBookingCode = string.Empty;

    [Parameter]
    public EventCallback OnOrderCreated { get; set; }

    private void SetSample(int index)
    {
        switch (index)
        {
            case 1:
                rawMessage = "Dạ chị ơi bên mình còn phòng ban mai 2 người từ 15/10 đến 17/10 ko ạ? Em tên Hoàng Đăng SĐT 0912345678, mình đến tầm 2h chiều nha chị.";
                break;
            case 2:
                rawMessage = "Chào homestay, mình muốn đặt phòng garden suite cho 3 người từ 18/10 đến 21/10. Mình tên Mai Anh 0988765432, có xe đạp điện trợ lực không bạn?";
                break;
            case 3:
                rawMessage = "Anh ơi đặt giúp em căn family eco-villa cho nhà 4 khách từ 20/10 đến 23/10 nhé. Em tên Thảo 0934567890. Nhớ chuẩn bị bồn ngâm chân thảo mộc giúp em.";
                break;
        }
        HandleExtract();
    }

    private void HandleExtract()
    {
        if (string.IsNullOrWhiteSpace(rawMessage)) return;

        isExtracting = true;
        isSaved = false;

        // Bóc tách bằng SmartPasteUseCase
        extractedData = SmartPasteUseCase.Execute(rawMessage);

        isExtracting = false;
    }

    private async Task ConfirmAndSave()
    {
        if (extractedData == null) return;

        string timestamp = DateTime.Now.ToString("yyyyMMdd");
        string randomSuffix = new Random().Next(100, 999).ToString();
        string uniqueCode = $"KLE-{timestamp}-{randomSuffix}";

        int productId = extractedData.RoomNameOrType.Contains("102") ? 2 :
                        extractedData.RoomNameOrType.Contains("201") ? 3 :
                        extractedData.RoomNameOrType.Contains("202") ? 4 :
                        extractedData.RoomNameOrType.Contains("203") ? 5 : 1;

        var order = new Order
        {
            UniqueId = uniqueCode,
            CustomerName = extractedData.CustomerName,
            CustomerAddress = $"{extractedData.PhoneNumber} — Zalo SmartPaste",
            CustomerCity = "Khai báo sau",
            CustomerStateProvince = $"{extractedData.CheckInDate:dd/MM} đến {extractedData.CheckOutDate:dd/MM}",
            CustomerCountry = extractedData.SpecialRequests,
            DatePlaced = DateTime.Now,
            LineItems = new List<OrderLineItem>
            {
                new OrderLineItem
                {
                    ProductId = productId,
                    Quantity = extractedData.TotalNights,
                    Price = (double)(extractedData.EstimatedTotal / Math.Max(1, extractedData.TotalNights))
                }
            }
        };

        OrderRepository.CreateOrder(order);

        isSaved = true;
        savedBookingCode = uniqueCode;

        if (OnOrderCreated.HasDelegate)
        {
            await OnOrderCreated.InvokeAsync();
        }
    }
}
