@using KimLongEcoStay.CoreBusiness.Models
@using KimLongEcoStay.CoreBusiness.Services
@using Microsoft.JSInterop
@inject IJSRuntime jsRuntime

<!-- =========================================================================
     MỤC 2: TRẢI NGHIỆM TRÀ CUNG ĐÌNH HUẾ (ROYAL TEA EXPERIENCES)
     ID: royal-tea
     ========================================================================= -->
<div class="tea-section mt-5" id="royal-tea" style="scroll-margin-top: 96px; padding-top: 30px;">
    <div class="container">
        <div class="section-heading-wrap text-center mb-4">
            <span class="section-tag" style="background: rgba(14, 94, 69, 0.15); color: #0E5E45; padding: 6px 18px; border-radius: 30px; font-weight: 700; font-size: 12px; letter-spacing: 1px;">
                <i class="bi bi-flower1 me-1"></i>NGHI THỨC TRÀ CỐ ĐÔ
            </span>
            <h2 class="section-main-title font-serif fw-bold text-dark mt-2 mb-2" style="font-size: 32px;">
                Trải Nghiệm Trà Cung Đình Huế
            </h2>
            <p class="section-main-sub mx-auto text-muted" style="max-width: 820px; font-size: 15px; line-height: 1.7;">
                Không gian thưởng trà thanh tịnh dưới mái nhà rường cổ kính và rặng bưởi Thanh Trà Kim Long. 
                Tuyển chọn 4 gói trải nghiệm văn hóa tao nhã dành cho quý khách lưu trú và khách tham quan.
            </p>

            <div class="d-flex justify-content-center gap-2 gap-md-3 mt-3 flex-wrap">
                <span class="badge bg-white text-success border px-3 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-cup-hot-fill me-1 text-warning"></i>Trà Sen Hồ Tịnh Tâm
                </span>
                <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-flower2 me-1 text-danger"></i>Thảo Mộc 16 Vị Cung Đình
                </span>
                <span class="badge bg-white text-success border px-3 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-house-door me-1 text-success"></i>Nhà Rường Di Sản
                </span>
                <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-clock-history me-1 text-primary"></i>Phục vụ 08:30 - 21:00
                </span>
            </div>
        </div>

        <div class="row g-4" id="teaServicesGrid">
            <!-- Gói 1: Thưởng trà tại homestay -->
            <div class="col-lg-6 col-xl-3">
                <div class="tea-card h-100 d-flex flex-column bg-white rounded-4 border shadow-sm overflow-hidden" style="transition: transform 0.2s ease;">
                    <div class="tea-card-header position-relative" style="height: 180px; overflow: hidden;">
                        <img src="images/nha_ruong_2.jpg" alt="Thưởng Trà Cung Đình Tại Homestay" class="w-100 h-100" style="object-fit: cover;" onerror="this.src='images/hero_ecostay.jpg'" />
                        <span class="badge bg-success position-absolute top-0 start-0 m-3 rounded-pill px-3 py-1 shadow-sm">
                            <i class="bi bi-cup-hot-fill me-1"></i>Cá Nhân
                        </span>
                        <span class="badge bg-dark bg-opacity-75 text-warning position-absolute bottom-0 end-0 m-3 rounded-pill px-2 py-1 small">
                            Còn 8 chỗ
                        </span>
                    </div>
                    <div class="tea-card-body p-3 d-flex flex-column flex-grow-1">
                        <h5 class="tea-card-title fw-bold text-dark mb-2 font-serif" style="font-size: 17px;">Thưởng Trà Cung Đình Tại Homestay</h5>
                        <p class="text-muted small mb-3 flex-grow-1" style="line-height: 1.6;">
                            Thưởng thức ấm trà sen Tịnh Tâm hoặc 16 vị thảo mộc bên hiên ngắm hoa cau vườn bưởi thanh trà ven sông Hương kèm mứt gừng Huế nồng ấm.
                        </p>
                        <div class="d-flex gap-1 flex-wrap mb-2">
                            <span class="badge bg-light text-secondary border rounded-pill"><i class="bi bi-clock me-1"></i>45 phút</span>
                            <span class="badge bg-light text-secondary border rounded-pill"><i class="bi bi-people me-1"></i>Tối đa 8 khách</span>
                            <span class="badge bg-light text-secondary border rounded-pill"><i class="bi bi-calendar-event me-1"></i>Sáng/Chiều/Tối</span>
                        </div>
                        <div class="p-2 bg-light rounded-3 small text-muted mb-3">
                            <i class="bi bi-info-circle me-1 text-warning"></i><strong>Lịch:</strong> 08:30 • 15:30 • 19:30
                        </div>
                        <div class="d-flex align-items-center justify-content-between pt-2 border-top mt-auto">
                            <div>
                                <span class="fs-5 fw-bold text-success font-monospace">85,000 đ</span>
                                <small class="text-muted">/người</small>
                            </div>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2" onclick="window.openTeaDetailModal('TEA-HOMESTAY')" title="Xem chi tiết gói trà">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm" onclick="window.openTeaBookingModal('TEA-HOMESTAY', 'Thưởng Trà Cung Đình Tại Homestay', 85000, 'người', 8)">
                                    Đặt Chỗ <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gói 2: Trà + Bánh Huế -->
            <div class="col-lg-6 col-xl-3">
                <div class="tea-card h-100 d-flex flex-column bg-white rounded-4 border shadow-sm overflow-hidden" style="transition: transform 0.2s ease;">
                    <div class="tea-card-header position-relative" style="height: 180px; overflow: hidden;">
                        <img src="images/mon_banhkhoai.jpg" alt="Trải Nghiệm Thưởng Trà Kết Hợp Bánh Huế" class="w-100 h-100" style="object-fit: cover;" onerror="this.src='images/hero_ecostay.jpg'" />
                        <span class="badge position-absolute top-0 start-0 m-3 rounded-pill px-3 py-1 shadow-sm text-white" style="background:#D97706;">
                            <i class="bi bi-stars me-1"></i>Trọn Gói
                        </span>
                        <span class="badge bg-dark bg-opacity-75 text-warning position-absolute bottom-0 end-0 m-3 rounded-pill px-2 py-1 small">
                            Còn 12 chỗ
                        </span>
                    </div>
                    <div class="tea-card-body p-3 d-flex flex-column flex-grow-1">
                        <h5 class="tea-card-title fw-bold text-dark mb-2 font-serif" style="font-size: 17px;">Thưởng Trà Kết Hợp Bánh Cổ Truyền</h5>
                        <p class="text-muted small mb-3 flex-grow-1" style="line-height: 1.6;">
                            Kết hợp ấm trà Cung Đình hảo hạng cùng mẹt bánh tiến vua: bánh đậu xanh trái cây, bánh sen nướng và mè xửng Kim Long truyền thống.
                        </p>
                        <div class="d-flex gap-1 flex-wrap mb-2">
                            <span class="badge bg-light text-secondary border rounded-pill"><i class="bi bi-clock me-1"></i>60 phút</span>
                            <span class="badge bg-light text-secondary border rounded-pill"><i class="bi bi-people me-1"></i>Tối đa 12 khách</span>
                            <span class="badge bg-light text-secondary border rounded-pill"><i class="bi bi-calendar-event me-1"></i>Sáng/Chiều</span>
                        </div>
                        <div class="p-2 bg-light rounded-3 small text-muted mb-3">
                            <i class="bi bi-info-circle me-1 text-warning"></i><strong>Lịch:</strong> 09:00 • 15:00
                        </div>
                        <div class="d-flex align-items-center justify-content-between pt-2 border-top mt-auto">
                            <div>
                                <span class="fs-5 fw-bold text-success font-monospace">135,000 đ</span>
                                <small class="text-muted">/người</small>
                            </div>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2" onclick="window.openTeaDetailModal('TEA-CAKES')" title="Xem chi tiết gói trà">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm" onclick="window.openTeaBookingModal('TEA-CAKES', 'Trải Nghiệm Thưởng Trà Kết Hợp Bánh Huế', 135000, 'người', 12)">
                                    Đặt Chỗ <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gói 3: Thưởng trà cặp đôi -->
            <div class="col-lg-6 col-xl-3">
                <div class="tea-card h-100 d-flex flex-column bg-white rounded-4 border shadow-sm overflow-hidden" style="transition: transform 0.2s ease;">
                    <div class="tea-card-header position-relative" style="height: 180px; overflow: hidden;">
                        <img src="images/nha_ruong_1.jpg" alt="Gói Thưởng Trà Cặp Đôi &amp; Nhóm Bạn" class="w-100 h-100" style="object-fit: cover;" onerror="this.src='images/hero_ecostay.jpg'" />
                        <span class="badge position-absolute top-0 start-0 m-3 rounded-pill px-3 py-1 shadow-sm text-white" style="background:#7C3AED;">
                            <i class="bi bi-heart-fill me-1"></i>Riêng Tư
                        </span>
                        <span class="badge bg-dark bg-opacity-75 text-warning position-absolute bottom-0 end-0 m-3 rounded-pill px-2 py-1 small">
                            Còn 4 chỗ
                        </span>
                    </div>
                    <div class="tea-card-body p-3 d-flex flex-column flex-grow-1">
                        <h5 class="tea-card-title fw-bold text-dark mb-2 font-serif" style="font-size: 17px;">Gói Thưởng Trà Cặp Đôi &amp; Nhóm Bạn</h5>
                        <p class="text-muted small mb-3 flex-grow-1" style="line-height: 1.6;">
                            Bàn trà riêng biệt giữa vườn bưởi thanh trà hoặc chòi ngắm sông Hương lãng mạn, chuẩn bị riêng ấm trà thảo mộc, khay bánh và nến hoa sen.
                        </p>
                        <div class="d-flex gap-1 flex-wrap mb-2">
                            <span class="badge bg-light text-secondary border rounded-pill"><i class="bi bi-clock me-1"></i>75 phút</span>
                            <span class="badge bg-light text-secondary border rounded-pill"><i class="bi bi-people me-1"></i>Tối đa 4 khách</span>
                            <span class="badge bg-light text-secondary border rounded-pill"><i class="bi bi-calendar-event me-1"></i>Hẹn trước</span>
                        </div>
                        <div class="p-2 bg-light rounded-3 small text-muted mb-3">
                            <i class="bi bi-info-circle me-1 text-warning"></i><strong>Lịch:</strong> Linh hoạt theo yêu cầu
                        </div>
                        <div class="d-flex align-items-center justify-content-between pt-2 border-top mt-auto">
                            <div>
                                <span class="fs-5 fw-bold text-success font-monospace">250,000 đ</span>
                                <small class="text-muted">/gói (2-4 người)</small>
                            </div>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2" onclick="window.openTeaDetailModal('TEA-COUPLE')" title="Xem chi tiết gói trà">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm" onclick="window.openTeaBookingModal('TEA-COUPLE', 'Gói Thưởng Trà Cặp Đôi & Nhóm Bạn', 250000, 'gói', 4)">
                                    Đặt Chỗ <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gói 4: Workshop Văn hóa Trà -->
            <div class="col-lg-6 col-xl-3">
                <div class="tea-card h-100 d-flex flex-column bg-white rounded-4 border shadow-sm overflow-hidden" style="transition: transform 0.2s ease;">
                    <div class="tea-card-header position-relative" style="height: 180px; overflow: hidden;">
                        <img src="images/song_huong_hoanghon.jpg" alt="Trải Nghiệm Văn Hóa Huế Kết Hợp Giới Thiệu Trà" class="w-100 h-100" style="object-fit: cover;" onerror="this.src='images/hero_ecostay.jpg'" />
                        <span class="badge position-absolute top-0 start-0 m-3 rounded-pill px-3 py-1 shadow-sm text-white" style="background:#B91C1C;">
                            <i class="bi bi-award-fill me-1"></i>Nghệ Nhân
                        </span>
                        <span class="badge bg-dark bg-opacity-75 text-warning position-absolute bottom-0 end-0 m-3 rounded-pill px-2 py-1 small">
                            Còn 6 chỗ
                        </span>
                    </div>
                    <div class="tea-card-body p-3 d-flex flex-column flex-grow-1">
                        <h5 class="tea-card-title fw-bold text-dark mb-2 font-serif" style="font-size: 17px;">Workshop Văn Hóa Trà Đạo Cố Đô</h5>
                        <p class="text-muted small mb-3 flex-grow-1" style="line-height: 1.6;">
                            Giao lưu cùng nghệ nhân trà đạo xứ Huế, hướng dẫn bí quyết sao ướp hoa sen Tịnh Tâm, kỹ thuật hãm nước giếng đá và thưởng thức theo nghi thức hoàng gia.
                        </p>
                        <div class="d-flex gap-1 flex-wrap mb-2">
                            <span class="badge bg-light text-secondary border rounded-pill"><i class="bi bi-clock me-1"></i>90 phút</span>
                            <span class="badge bg-light text-secondary border rounded-pill"><i class="bi bi-people me-1"></i>Tối đa 6 khách</span>
                            <span class="badge bg-light text-secondary border rounded-pill"><i class="bi bi-calendar-event me-1"></i>Buổi chiều</span>
                        </div>
                        <div class="p-2 bg-light rounded-3 small text-muted mb-3">
                            <i class="bi bi-info-circle me-1 text-warning"></i><strong>Lịch:</strong> 15:30 - 17:00 hàng ngày
                        </div>
                        <div class="d-flex align-items-center justify-content-between pt-2 border-top mt-auto">
                            <div>
                                <span class="fs-5 fw-bold text-success font-monospace">390,000 đ</span>
                                <small class="text-muted">/gói trải nghiệm</small>
                            </div>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2" onclick="window.openTeaDetailModal('TEA-CULTURE')" title="Xem chi tiết gói trà">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm" onclick="window.openTeaBookingModal('TEA-CULTURE', 'Gói Trải Nghiệm Văn Hóa Huế Kết Hợp Giới Thiệu Trà', 390000, 'gói', 6)">
                                    Đặt Chỗ <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Banner tư vấn & hotline nhanh -->
        <div class="bg-white p-3 p-md-4 rounded-4 border shadow-sm mt-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="badge rounded-circle p-3 text-white" style="background: var(--kle-primary, #14452F); font-size: 20px;">
                    <i class="bi bi-cup-hot"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1 text-dark">Quý khách muốn tổ chức tiệc trà riêng hoặc thưởng trà theo yêu cầu đặc biệt?</h6>
                    <small class="text-muted">Chúng tôi sẵn sàng phục vụ tại sân vườn, chòi ngắm hoàng hôn sông Hương hoặc hiên nhà rường cổ.</small>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="tel:0905123456" class="btn btn-outline-success rounded-pill px-3 py-2 fw-bold">
                    <i class="bi bi-telephone-fill me-1"></i>Hotline: 0905.123.456
                </a>
                <button type="button" class="btn btn-success rounded-pill px-3 py-2 fw-bold" onclick="window.openTeaBookingModal('TEA-HOMESTAY', 'Thưởng Trà Cung Đình Tại Homestay', 85000, 'người', 8)">
                    <i class="bi bi-calendar-check me-1"></i>Đặt Chỗ Ngay
                </button>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL CHI TIẾT TRÀ CUNG ĐÌNH (TEA DETAIL MODAL)
     ========================================================================= -->
<div class="modal fade" id="teaDetailModal" tabindex="-1" aria-labelledby="teaDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #14452F, #0E5E45);">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-flower1 fs-4 text-warning"></i>
                    <div>
                        <h5 class="modal-title font-serif fw-bold mb-0" id="teaDetailModalTitle">Chi Tiết Trải Nghiệm Trà Cung Đình</h5>
                        <small class="text-light opacity-75">Nghi thức thưởng trà tao nhã chốn Cố Đô</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4" id="teaDetailModalBody">
                <!-- Nội dung được cập nhật động bằng JavaScript -->
            </div>
            <div class="modal-footer bg-light border-top d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-success rounded-pill px-4 fw-bold" id="teaDetailModalBookBtn">
                    <i class="bi bi-calendar-check me-1"></i>Đặt Gói Trải Nghiệm Này
                </button>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL ĐẶT LỊCH TRÀ CUNG ĐÌNH (TEA BOOKING MODAL)
     ========================================================================= -->
<div class="modal fade" id="teaBookingModal" tabindex="-1" aria-labelledby="teaBookingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #14452F, #0E5E45);">
                <div>
                    <h5 class="modal-title font-serif fw-bold mb-0" id="teaBookingModalLabel">
                        <i class="bi bi-calendar2-check-fill me-2 text-warning"></i>Đăng Ký Thưởng Trà Cung Đình
                    </h5>
                    <small class="text-light opacity-75" id="teaModalSelectedTitle">Gói trải nghiệm văn hóa</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form onsubmit="window.handleTeaBookingSubmit(event)">
                <div class="modal-body p-4">
                    <input type="hidden" id="teaServiceCode" value="TEA-HOMESTAY" />
                    <input type="hidden" id="teaServiceName" value="Thưởng Trà Cung Đình Tại Homestay" />
                    <input type="hidden" id="teaServiceUnitPrice" value="85000" />
                    <input type="hidden" id="teaServicePriceType" value="người" />
                    <input type="hidden" id="teaServiceMaxCapacity" value="8" />

                    <!-- Thẻ tóm tắt gói dịch vụ đã chọn -->
                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="text-success font-serif" id="teaModalCardTitle">Thưởng Trà Cung Đình Tại Homestay</strong>
                            <span class="badge bg-warning text-dark font-monospace" id="teaModalSelectedPrice">85,000 đ</span>
                        </div>
                        <small class="text-muted d-block" id="teaModalSelectedCapacity">Sức chứa: 8 khách</small>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Ngày Thưởng Trà *</label>
                            <input type="date" id="teaBookingDate" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Khung Giờ Phục Vụ *</label>
                            <select id="teaTimeSlot" class="form-select" required>
                                <option value="08:30 - 09:30">08:30 - 09:30 (Buổi Sáng)</option>
                                <option value="15:30 - 16:30" selected>15:30 - 16:30 (Buổi Chiều Hoàng Hôn)</option>
                                <option value="19:30 - 20:30">19:30 - 20:30 (Buổi Tối Đèn Lồng)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Số Lượng Khách *</label>
                            <input type="number" id="teaGuestsCount" class="form-control" min="1" max="12" value="2" oninput="window.calculateTeaBookingTotal()" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Số Phòng (Nếu đang lưu trú)</label>
                            <input type="text" id="teaRoomNumber" class="form-control" placeholder="VD: Eco-Nest 101" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Họ Và Tên Quý Khách *</label>
                            <input type="text" id="teaCustomerName" class="form-control" placeholder="Nguyễn Văn A" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Số Điện Thoại / Zalo *</label>
                            <input type="tel" id="teaCustomerPhone" class="form-control" placeholder="0905 123 456" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Email Nhận Xác Nhận *</label>
                            <input type="email" id="teaCustomerEmail" class="form-control" placeholder="email@example.com" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Yêu Cầu Đặc Biệt (Tùy chọn)</label>
                            <textarea id="teaNotes" class="form-control" rows="2" placeholder="Ghi chú về vị trà, dị ứng hoặc chuẩn bị bàn tiệc riêng..."></textarea>
                        </div>
                    </div>

                    <!-- Tổng thanh toán tạm tính -->
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <span class="fw-bold text-dark">Tổng chi phí dự kiến:</span>
                        <span class="fs-4 fw-bold text-success font-monospace" id="teaBookingTotalDisplay">170,000 đ</span>
                    </div>
                    <small class="text-muted d-block mt-1">
                        <i class="bi bi-shield-check text-success me-1"></i>Miễn phí hủy hoặc đổi lịch trước 2 tiếng. Thanh toán trực tiếp tại quầy hoặc tính vào tiền phòng.
                    </small>
                </div>
                <div class="modal-footer bg-light border-top d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow" id="teaSubmitBtn">
                        <i class="bi bi-check-circle-fill me-1"></i>Xác Nhận Đặt Chỗ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

