@using KimLongEcoStay.CoreBusiness.Models

<div class="col mb-4">
    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
        <img src="@product?.ImageLink" class="card-img-top" alt="@product?.Name" style="height: 220px; object-fit: cover;" />
        <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-success bg-opacity-10 text-success fw-semibold">🌿 Kim Long EcoStay</span>
                <span class="badge bg-primary">@product?.Price.ToString("N0") đ/đêm</span>
            </div>
            <h5 class="card-title fw-bold text-dark">@product?.Name</h5>
            <p class="card-text text-muted small flex-grow-1">@product?.Description</p>
            <a href="/room/@product?.ProductId" class="btn btn-outline-success w-100 mt-2">
                🏡 Xem Chi Tiết & Đặt Phòng
            </a>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Product? product { get; set; }
}
