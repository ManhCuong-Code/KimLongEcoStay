@page "/placeorder"
@rendermode InteractiveServer

@using KimLongEcoStay.CoreBusiness.Models
@using KimLongEcoStay.UseCases.ShoppingCartScreen.Interfaces
@using KimLongEcoStay.UseCases.ViewProductSrceen.Interfaces
@using KimLongEcoStay.UseCases.SearchProductScreen

@inject IViewShoppingCartUseCase viewShoppingCartUseCase
@inject IPlaceOrderUseCase placeOrderUseCase
@inject IAddProductToCartUseCase addProductToCartUseCase
@inject ISearchProductUseCase searchProductUseCase
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Thông Tin Khách Lưu Trú & Xác Nhận Đặt Phòng — Kim Long EcoStay</PageTitle>

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb bg-white p-3 rounded-3 border shadow-sm small">
            <li class="breadcrumb-item"><a href="" class="text-success text-decoration-none"><i class="bi bi-house-door me-1"></i>Trang Chủ</a></li>
            <li class="breadcrumb-item"><a href="cart" class="text-success text-decoration-none">Phòng Đã Chọn</a></li>
            <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">Xác Nhận Lưu Trú & Đặt Cọc</li>
        </ol>
    </nav>

    <!-- Header Tiêu Đề -->
    <div class="mb-4">
        <h2 class="fw-bold text-dark font-serif mb-1">
            <i class="bi bi-person-lines-fill text-gold me-2"></i>Thông Tin Khách Lưu Trú & Xác Nhận Đặt Phòng
        </h2>
        <p class="text-muted mb-0 small">
            Hệ thống nhà vườn sinh thái Kim Long áp dụng công nghệ khóa tự động SmartLock 10s. Thông tin chính xác giúp quý khách nhận phòng thông suốt.
        </p>
    </div>

    <!-- Hộp Thông Báo Thành Viên -->
    <div class="alert alert-light border shadow-sm mb-4 rounded-3 d-flex align-items-center">
        <AuthorizeView>
            <Authorized>
                <i class="bi bi-patch-check-fill text-success fs-2 me-3"></i>
                <div>
                    <span class="badge bg-success me-2">Thành Viên Đã Đăng Nhập</span>
                    <span>Xin chào quý khách <strong>@context.User.Identity?.Name</strong>. Hệ thống đã tự động liên kết tài khoản để kích hoạt mã khóa SmartLock.</span>
                </div>
            </Authorized>
            <NotAuthorized>
                <i class="bi bi-info-circle-fill text-gold fs-2 me-3"></i>
                <div>
                    <span class="badge bg-warning text-dark me-2">Đặt Trực Tiếp Không Cần Tài Khoản</span>
                    <span>Quý khách đang đặt phòng nhanh. Vui lòng cung cấp <strong>Số điện thoại</strong> chính xác để nhận mã PIN mở cửa phòng và thông tin chuyển cọc VietQR.</span>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>

    @if (order == null)
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
            <div class="spinner-border text-success mb-3" role="status"></div>
            <p class="text-muted fw-semibold">Đang chuẩn bị thông tin đặt buồng phòng Kim Long EcoStay...</p>
        </div>
    }
    else
    {
        <!-- BẢNG CHỌN PHÒNG NHANH NẾU GIỎ HÀNG ĐANG RỖNG -->
        @if (order.LineItems == null || order.LineItems.Count == 0)
        {
            <div class="alert alert-warning border border-warning shadow-sm rounded-4 p-4 mb-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-door-closed-fill text-warning fs-3"></i>
                    <h5 class="fw-bold mb-0 text-dark font-serif">Quý Khách Chưa Chọn Buồng Phòng Lưu Trú</h5>
                </div>
                <p class="text-muted small mb-3">
                    Vui lòng bấm chọn ngay 1 trong các buồng phòng sinh thái Cố đô dưới đây để hệ thống tính giá và kích hoạt mã khóa SmartLock:
                </p>
                <div class="row g-3">
                    @foreach (var room in availableRooms)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 border shadow-sm rounded-3 overflow-hidden">
                                <img src="@room.ImageLink" class="card-img-top" style="height: 130px; object-fit: cover;" onerror="this.src='/images/room_econest.jpg'" alt="@room.Name" />
                                <div class="card-body p-3 d-flex flex-column">
                                    <h6 class="fw-bold text-dark mb-1 small">@room.Name</h6>
                                    <small class="text-muted mb-2" style="font-size: 11px;"><i class="bi bi-flower1 text-success me-1"></i>@room.Brand</small>
                                    <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                                        <span class="text-danger fw-bold small">@room.Price.ToString("N0") đ <small class="text-muted">/ đêm</small></span>
                                        <button class="btn btn-sm btn-success rounded-pill px-3 fw-bold" @onclick="() => SelectRoomQuickly(room.Id)">
                                            <i class="bi bi-plus-lg me-1"></i>Chọn Phòng
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="row g-4">
            <!-- Cột Trái: Form Điền Thông Tin Khách -->
            <div class="col-lg-7">
                <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border">
                    <h5 class="fw-bold text-dark font-serif mb-3 border-bottom pb-2">
                        <i class="bi bi-card-checklist text-success me-2"></i>Chi Tiết Khách Lưu Trú
                    </h5>

                    @if (isError)
                    {
                        <div class="alert alert-danger d-flex align-items-center mb-4 rounded-3 shadow-sm border border-danger">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-4 me-3"></i>
                            <div>
                                <strong class="d-block mb-1">Chưa thể xác nhận đặt phòng!</strong>
                                <span>@errorMessage</span>
                            </div>
                        </div>
                    }

                    <!-- Họ và Tên Khách Lưu Trú -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small">
                            <i class="bi bi-person-fill text-success me-1"></i>Họ và Tên Khách Lưu Trú <span class="text-danger">*</span>:
                        </label>
                        <input type="text" 
                               class="form-control form-control-lg rounded-3 @(GetValidationClass("name"))" 
                               value="@order.CustomerName" 
                               @oninput="HandleNameInput"
                               @onblur='() => ValidateField("name")'
                               placeholder="Ví dụ: Nguyễn Văn Hoàng" />
                        @if (fieldErrors.ContainsKey("name"))
                        {
                            <div class="text-danger small mt-1 fw-bold d-flex align-items-center gap-1">
                                <i class="bi bi-exclamation-circle-fill"></i> @fieldErrors["name"]
                            </div>
                        }
                    </div>

                    <!-- Số Điện Thoại / Zalo -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small">
                            <i class="bi bi-telephone-fill text-primary me-1"></i>Số Điện Thoại / Zalo Nhận Mã PIN Khóa Phòng <span class="text-danger">*</span>:
                        </label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light text-muted fw-bold border-end-0">
                                <span class="me-1">🇻🇳</span> +84
                            </span>
                            <input type="tel" 
                                   class="form-control rounded-end-3 @(GetValidationClass("phone"))" 
                                   value="@customerPhone" 
                                   @oninput="HandlePhoneInput"
                                   @onblur='() => ValidateField("phone")'
                                   placeholder="0905 123 456 hoặc 0912..." />
                        </div>
                        @if (fieldErrors.ContainsKey("phone"))
                        {
                            <div class="text-danger small mt-1 fw-bold d-flex align-items-center gap-1">
                                <i class="bi bi-exclamation-circle-fill"></i> @fieldErrors["phone"]
                            </div>
                        }
                        <small class="text-muted d-block mt-1" style="font-size: 11.5px;">
                            <i class="bi bi-shield-lock-fill text-success me-1"></i>Hệ thống tự động kích hoạt cấp <strong>Mã PIN SmartLock 6 số</strong> gửi qua tin nhắn Zalo/SMS đến số điện thoại này.
                        </small>
                    </div>

                    <!-- Email Nhận Mã PIN & Xác Nhận -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small">
                            <i class="bi bi-envelope-at-fill text-danger me-1"></i>Email Nhận Mã PIN & Phiếu Xác Nhận Đặt Cọc <span class="text-danger">*</span>:
                        </label>
                        <input type="email" 
                               class="form-control form-control-lg rounded-3 @(GetValidationClass("email"))" 
                               value="@order.CustomerEmail" 
                               @oninput="HandleEmailInput"
                               @onblur='() => ValidateField("email")'
                               placeholder="Ví dụ: hoang.nguyen@gmail.com" />
                        @if (fieldErrors.ContainsKey("email"))
                        {
                            <div class="text-danger small mt-1 fw-bold d-flex align-items-center gap-1">
                                <i class="bi bi-exclamation-circle-fill"></i> @fieldErrors["email"]
                            </div>
                        }
                        <small class="text-muted d-block mt-1" style="font-size: 11.5px;">
                            <i class="bi bi-send-check-fill text-success me-1"></i>Hệ thống sẽ tự động gửi hướng dẫn mở cửa phòng, định vị bản đồ và phiếu cọc VietQR về email này.
                        </small>
                    </div>

                    <!-- Địa Chỉ Thường Trú / Tỉnh Thành -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small">
                            <i class="bi bi-geo-alt-fill text-secondary me-1"></i>Địa Chỉ Thường Trú / Nơi Xuất Phát (Tùy chọn):
                        </label>
                        <input type="text" 
                               class="form-control rounded-3" 
                               @bind="customerAddressOnly" 
                               placeholder="Ví dụ: 128 Lê Lợi, TP. Huế (hoặc Hà Nội, TP.HCM, Đà Nẵng...)" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small">
                                <i class="bi bi-credit-card-2-front-fill text-info me-1"></i>Số CCCD / Hộ Chiếu (Đăng ký tạm trú):
                            </label>
                            <input type="text" class="form-control rounded-3" @bind="order.CustomerCity" placeholder="Ví dụ: 046098001234" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small">
                                <i class="bi bi-clock-fill text-warning me-1"></i>Giờ Nhận Phòng Dự Kiến:
                            </label>
                            <input type="text" class="form-control rounded-3" @bind="order.CustomerStateProvince" placeholder="Ví dụ: 14:30 chiều" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark small">
                            <i class="bi bi-chat-square-dots-fill text-danger me-1"></i>Yêu Cầu Đặc Biệt & Ghi Chú:
                        </label>
                        <input type="text" class="form-control rounded-3" @bind="order.CustomerCountry" placeholder="Ví dụ: Cần mượn xe đạp trợ lực điện, chuẩn bị trà sen nóng, ăn chay Cố đô..." />
                    </div>

                    <!-- Nút Đặt Cọc Hoàn Tất -->
                    <button class="btn btn-success btn-lg w-100 py-3 fw-bold rounded-3 shadow d-flex align-items-center justify-content-center gap-2" 
                            @onclick="HandlePlaceOrder" 
                            disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>ĐANG TẠO MÃ CỌC VIETQR & PIN SMARTLOCK...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle fs-4"></i>
                            <span>XÁC NHẬN ĐẶT PHÒNG & XUẤT PHIẾU CỌC VIETQR</span>
                        }
                    </button>

                    <div class="text-center mt-3 text-muted" style="font-size: 11.5px;">
                        <i class="bi bi-lock-fill text-success me-1"></i>Thông tin được mã hóa bảo mật. Cam kết giữ buồng phòng 100% không trùng lịch (0% Overbooking).
                    </div>
                </div>
            </div>

            <!-- Cột Phải: Tóm Tắt Chi Phí -->
            <div class="col-lg-5">
                <div class="sticky-top" style="top: 90px; z-index: 10;">
                    <!-- Danh Sách Phòng Đã Chọn Rõ Ràng -->
                    @if (order.LineItems != null && order.LineItems.Count > 0)
                    {
                        <div class="bg-white p-3 rounded-4 shadow-sm border mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                <span class="fw-bold text-dark small font-serif">
                                    <i class="bi bi-door-open-fill text-success me-1"></i>Phòng Đang Đặt (@order.LineItems.Count)
                                </span>
                                <a href="cart" class="text-success small text-decoration-none">
                                    <i class="bi bi-pencil-square me-1"></i>Chỉnh sửa
                                </a>
                            </div>
                            @foreach (var item in order.LineItems)
                            {
                                <div class="d-flex align-items-center gap-2 py-2 border-bottom border-light">
                                    @if (!string.IsNullOrEmpty(item.Product?.ImageLink))
                                    {
                                        <img src="@item.Product.ImageLink" style="width: 50px; height: 40px; object-fit: cover; border-radius: 6px;" onerror="this.src='/images/room_econest.jpg'" alt="@item.Product?.Name" />
                                    }
                                    <div class="flex-grow-1">
                                        <div class="fw-bold text-dark small">@(item.Product?.Name ?? $"Phòng #{item.ProductId}")</div>
                                        <small class="text-muted" style="font-size: 11px;">@item.Quantity đêm × @item.Price.ToString("N0") đ</small>
                                    </div>
                                    <div class="text-end fw-bold text-dark small">
                                        @((item.Price * item.Quantity).ToString("N0")) đ
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <OrderSummaryComponent Order="order" HidePlaceOrderButton="true"></OrderSummaryComponent>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public int? roomId { get; set; }

    private Order? order;
    private List<Product> availableRooms = new();
    private string customerPhone = string.Empty;
    private string customerAddressOnly = string.Empty;
    private bool isError = false;
    private bool isSubmitting = false;
    private string errorMessage = "Vui lòng nhập đầy đủ thông tin để tiến hành đặt phòng.";
    private Dictionary<string, string> fieldErrors = new(StringComparer.OrdinalIgnoreCase);

    // Regex kiểm tra số điện thoại di động Việt Nam (10 chữ số)
    private static readonly System.Text.RegularExpressions.Regex PhoneRegex = 
        new(@"^(?:(?:\+84)|0)(?:3[2-9]|5[25689]|7[06-9]|8[1-9]|9\d)\d{7}$", System.Text.RegularExpressions.RegexOptions.Compiled);

    // Regex kiểm tra Email chuẩn
    private static readonly System.Text.RegularExpressions.Regex EmailRegex = 
        new(@"^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$", System.Text.RegularExpressions.RegexOptions.Compiled);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            order = await viewShoppingCartUseCase.Execute();

            // Nếu URL truyền roomId (từ nút Đặt Phòng Nhanh), đảm bảo phòng đã được thêm vào giỏ
            if (roomId.HasValue && roomId.Value > 0)
            {
                if (order == null || order.LineItems == null || !order.LineItems.Any(x => x.ProductId == roomId.Value))
                {
                    await addProductToCartUseCase.ExecuteAsync(roomId.Value);
                    order = await viewShoppingCartUseCase.Execute();
                }
            }

            // Nếu giỏ rỗng, nạp sẵn danh sách phòng để khách chọn nhanh
            if (order == null || order.LineItems == null || order.LineItems.Count == 0)
            {
                try
                {
                    availableRooms = searchProductUseCase.Execute()?.ToList() ?? new();
                }
                catch
                {
                    availableRooms = new();
                }
            }
            
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity != null && user.Identity.IsAuthenticated && order != null)
            {
                if (string.IsNullOrWhiteSpace(order.CustomerName))
                {
                    order.CustomerName = user.Identity.Name ?? string.Empty;
                }

                if (string.IsNullOrWhiteSpace(order.CustomerEmail))
                {
                    var emailClaim = user.Claims.FirstOrDefault(c => c.Type.Contains("email", StringComparison.OrdinalIgnoreCase));
                    if (emailClaim != null && !string.IsNullOrWhiteSpace(emailClaim.Value))
                    {
                        order.CustomerEmail = emailClaim.Value;
                    }
                }
            }

            // Tách số điện thoại và địa chỉ nếu đã có sẵn
            if (order != null && !string.IsNullOrWhiteSpace(order.CustomerAddress))
            {
                var parts = order.CustomerAddress.Split(new[] { "—", "-" }, 2, StringSplitOptions.TrimEntries);
                customerPhone = parts[0];
                if (parts.Length > 1)
                {
                    customerAddressOnly = parts[1];
                }
            }

            StateHasChanged();
        }
    }

    private async Task SelectRoomQuickly(int id)
    {
        await addProductToCartUseCase.ExecuteAsync(id);
        order = await viewShoppingCartUseCase.Execute();
        isError = false;
        errorMessage = string.Empty;
        StateHasChanged();
    }

    private string GetValidationClass(string fieldName)
    {
        if (fieldErrors.ContainsKey(fieldName))
        {
            return "is-invalid border-danger";
        }
        return "";
    }

    private void HandleNameInput(ChangeEventArgs e)
    {
        if (order != null) order.CustomerName = e.Value?.ToString() ?? string.Empty;
        ValidateField("name");
    }

    private void HandlePhoneInput(ChangeEventArgs e)
    {
        customerPhone = e.Value?.ToString() ?? string.Empty;
        ValidateField("phone");
    }

    private void HandleEmailInput(ChangeEventArgs e)
    {
        if (order != null) order.CustomerEmail = e.Value?.ToString() ?? string.Empty;
        ValidateField("email");
    }

    private bool ValidateField(string fieldName)
    {
        switch (fieldName.ToLower())
        {
            case "name":
                if (string.IsNullOrWhiteSpace(order?.CustomerName))
                {
                    fieldErrors["name"] = "Vui lòng nhập Họ và Tên khách lưu trú.";
                    return false;
                }
                if (order.CustomerName.Trim().Length < 2)
                {
                    fieldErrors["name"] = "Họ và Tên quá ngắn, vui lòng nhập họ tên đầy đủ.";
                    return false;
                }
                fieldErrors.Remove("name");
                return true;

            case "phone":
                var cleanPhone = customerPhone.Replace(" ", "").Replace(".", "").Replace("-", "").Trim();
                if (string.IsNullOrWhiteSpace(cleanPhone))
                {
                    fieldErrors["phone"] = "Vui lòng nhập số điện thoại để nhận mã PIN mở cửa SmartLock qua Zalo/SMS.";
                    return false;
                }
                if (!PhoneRegex.IsMatch(cleanPhone))
                {
                    fieldErrors["phone"] = "Số điện thoại không hợp lệ! Vui lòng nhập số điện thoại Việt Nam gồm 10 chữ số (Ví dụ: 0905 123 456, 0912 345 678).";
                    return false;
                }
                fieldErrors.Remove("phone");
                return true;

            case "email":
                var email = order?.CustomerEmail?.Trim() ?? string.Empty;
                if (string.IsNullOrWhiteSpace(email))
                {
                    fieldErrors["email"] = "Vui lòng nhập địa chỉ Email để nhận phiếu đặt cọc và hướng dẫn nhận phòng.";
                    return false;
                }
                if (!EmailRegex.IsMatch(email))
                {
                    fieldErrors["email"] = "Định dạng Email không chính xác! Ví dụ đúng: khachhang@gmail.com.";
                    return false;
                }
                fieldErrors.Remove("email");
                return true;

            default:
                return true;
        }
    }

    private bool ValidateAll()
    {
        fieldErrors.Clear();
        bool validName = ValidateField("name");
        bool validPhone = ValidateField("phone");
        bool validEmail = ValidateField("email");

        if (!validName || !validPhone || !validEmail)
        {
            isError = true;
            errorMessage = "Vui lòng kiểm tra và sửa các thông tin chưa hợp lệ (được đánh dấu đỏ bên dưới).";
            return false;
        }

        isError = false;
        errorMessage = string.Empty;
        return true;
    }

    private async Task HandlePlaceOrder()
    {
        if (isSubmitting) return;

        if (order == null)
        {
            errorMessage = "Đơn đặt phòng không hợp lệ.";
            isError = true;
            return;
        }

        if (order.LineItems == null || order.LineItems.Count == 0)
        {
            errorMessage = "Quý khách chưa chọn buồng phòng lưu trú! Vui lòng bấm chọn 1 phòng bên trên trước khi xác nhận.";
            isError = true;
            return;
        }

        if (!ValidateAll())
        {
            return;
        }

        // Định dạng lưu trữ chuẩn cho hệ thống
        var cleanPhone = customerPhone.Replace(" ", "").Replace(".", "").Replace("-", "").Trim();
        if (!string.IsNullOrWhiteSpace(customerAddressOnly))
        {
            order.CustomerAddress = $"{cleanPhone} — {customerAddressOnly.Trim()}";
        }
        else
        {
            order.CustomerAddress = cleanPhone;
        }

        // Đảm bảo các trường địa lý không rỗng để OrderService validate hợp lệ
        if (string.IsNullOrWhiteSpace(order.CustomerCity)) order.CustomerCity = "Huế";
        if (string.IsNullOrWhiteSpace(order.CustomerStateProvince)) order.CustomerStateProvince = "Thừa Thiên Huế";
        if (string.IsNullOrWhiteSpace(order.CustomerCountry)) order.CustomerCountry = "Việt Nam";

        isSubmitting = true;
        isError = false;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            string? orderUniqueId = await placeOrderUseCase.Execute(order);
            if (!string.IsNullOrEmpty(orderUniqueId))
            {
                navigationManager.NavigateTo($"/orderconfirm/{orderUniqueId}");
            }
            else
            {
                isError = true;
                errorMessage = "Hệ thống chưa thể xử lý đơn đặt phòng. Vui lòng kiểm tra lại thông tin họ tên, số điện thoại hoặc liên hệ Hotline 0905.123.456.";
                isSubmitting = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            isError = true;
            errorMessage = $"Lỗi hệ thống khi tạo đơn: {ex.Message}. Vui lòng thử lại hoặc gọi Hotline 0905.123.456.";
            isSubmitting = false;
            StateHasChanged();
        }
    }
}
