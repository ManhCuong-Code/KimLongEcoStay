{
  "name": "Kim Long EcoStay (Blazor .NET + SQL Server)",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [5204, 1433],
  "portsAttributes": {
    "5204": {
      "label": "Kim Long EcoStay Web App",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    },
    "1433": {
      "label": "SQL Server 2022 Database",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "postCreateCommand": "chmod +x start.sh .devcontainer/setup.sh 2>/dev/null || true; bash .devcontainer/setup.sh || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-mssql.mssql"
      ]
    }
  }
}
