@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam roundcorner 10
skinparam shadowing false

skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #6C5CE7
    FontColor #2D3436
    DiamondBackgroundColor #FFEAA7
    DiamondBorderColor #F39C12
    ArrowColor #2D3436
}

title SƠ ĐỒ HOẠT ĐỘNG (ACTIVITY DIAGRAM): LUỒNG ĐẶT PHÒNG & THỰC THI 2 LUẬT NGHIỆP VỤ - DỰ ÁN HOMESTAY HUẾ\n(Tiêu chí K1.3: Cài đặt trong CoreBusiness/UseCases & K3.3: Báo lỗi thân thiện)

start

:Khách hàng chọn loại phòng và khoảng ngày lưu trú\n(Ngày đến: CheckInDate, Ngày đi: CheckOutDate);

partition "Tầng UseCases & CoreBusiness: Kiểm Tra Luật 1 (Overbooking)" {
    :Truy vấn SQL tham số hóa tìm các đêm đã có khách ở\ntrong khoảng [CheckInDate, CheckOutDate) (K2.3);
    
    if (Tồn tại đêm nào bị trùng lịch trong khoảng ngày?) then (Có trùng đêm)
        :Ném ngoại lệ nghiệp vụ OverbookingConflictException;
        :Hiển thị thông báo lỗi thân thiện cạnh ô nhập (K3.2, K3.3):\n"Phòng đã kín trong các đêm bạn chọn, vui lòng chọn ngày khác!";
        stop
    else (Không trùng đêm)
        note right
          <b>Đặc tả Luật 1:</b>
          Khách cũ Check-out lúc 12h00 ngày D
          và khách mới Check-in lúc 14h00 ngày D
          -> Được chấp nhận vì không trùng đêm lưu trú!
        end note
        :Xác nhận phòng khả dụng;
    endif
}

:Thêm phòng vào giỏ chọn tạm BookingCartState (Scoped - K1.4);

:Khách hàng nhập thông tin cá nhân vào EditForm (K3.2)\n(Họ tên, SĐT, Email, Yêu cầu đặc biệt);

partition "Tầng UseCases & CoreBusiness: Kiểm Tra Luật 2 (Dynamic Pricing)" {
    :Khởi tạo Tổng_tiền = 0;
    while (Duyệt từng đêm trong khoảng [CheckInDate, CheckOutDate)?) is (Còn đêm)
        if (Đêm rơi vào Thứ 6 hoặc Thứ 7?) then (Cuối tuần)
            :Lấy giá RatePlan cuối tuần (vd: 850.000 VNĐ);
        else (Ngày thường)
            :Lấy giá RatePlan ngày thường (vd: 600.000 VNĐ);
        endif
        :Tổng_tiền += Giá_đêm;
    endwhile (Hết các đêm)
    :Tính tiền đặt cọc bắt buộc = 50% * Tổng_tiền;
}

:Khách hàng xác nhận đặt phòng;

partition "Tầng Plugins.DataStore.SQL: Ghi Dữ Liệu Transaction (K2.2)" {
    :Khởi tạo Database Transaction;
    :INSERT INTO Booking (Header) với trạng thái 'PENDING_DEPOSIT';
    :INSERT INTO BookingNight (LineItems) cho từng đêm lưu trú;
    :Commit Transaction thành công;
}

:Hiển thị mã VietQR chuyển khoản cọc;

if (Thanh toán cọc thành công trong 30 phút?) then (Có)
    :Cập nhật trạng thái Booking thành 'CONFIRMED';
    :Gửi tin nhắn SMS / Email xác nhận kèm mã đơn;
    stop
else (Không / Hết hạn)
    :Hệ thống tự động hủy đơn và giải phóng phòng;
    stop
endif

@enduml
