@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam roundcorner 10
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #6C5CE7
    FontColor #2D3436
}

skinparam usecase {
    BackgroundColor #F1F2F6
    BorderColor #6C5CE7
    FontColor #2F3542
    ArrowColor #2F3542
}

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #A4B0BE
}

title SƠ ĐỒ USE CASE TỔNG THỂ - DỰ ÁN: KIM LONG ECOSTAY (ECO2415)\n(Chuẩn hóa 2 vai trò, 2 luật nghiệp vụ & mở rộng AI theo Chuẩn Barem Chấm thi)

' ================= ACTORS =================
actor "Khách Hàng\n(Khách du lịch / Guest)" as Guest
actor "Chủ Homestay / Lễ Tân\n(Quản trị / Host)" as Host
actor "Cổng Thanh Toán / Ngân Hàng\n(VietQR / Banking)" as Bank <<External System>>
actor "Dịch Vụ AI (IChatClient)\n(OpenAI / Gemini / Ollama)" as AI <<External System>>

rectangle "Hệ Thống Đặt Phòng Trực Tuyến Kim Long EcoStay (Clean Architecture)" {

    ' ----------------- PHÂN HỆ KHÁCH HÀNG -----------------
    package "Phân Hệ Khách Hàng (Client Portal)" {
        usecase "UC01: Tìm kiếm phòng theo ngày & số khách\n(Truy vấn khoảng ngày không chồng lấn)" as UC_Search
        usecase "UC02: Xem chi tiết phòng & bảng giá từng đêm" as UC_ViewDetail
        usecase "UC03: Chọn phòng vào Giỏ tạm\n(Scoped BookingCartState)" as UC_AddToCart
        usecase "UC04: Đặt phòng trực tuyến\n(Hỗ trợ đặt nhiều phòng)" as UC_Checkout
        usecase "UC05: Kiểm tra phòng không bị đặt chồng ngày\n[LUẬT NGHIỆP VỤ 1]" as UC_Rule1
        usecase "UC06: Tự động tính tiền = Σ giá từng đêm\n[LUẬT NGHIỆP VỤ 2]" as UC_Rule2_Pricing
        usecase "UC07: Thanh toán tiền cọc qua VietQR" as UC_Payment
        usecase "UC08: Xem lịch sử & trạng thái đơn đặt phòng" as UC_ViewHistory
        usecase "UC09: Yêu cầu hủy đặt phòng\n(Hủy < 48h phạt 1 đêm) [LUẬT NGHIỆP VỤ 2]" as UC_Rule2_Cancel
    }

    ' ----------------- PHÂN HỆ QUẢN TRỊ -----------------
    package "Phân Hệ Quản Trị & Vận Hành (Host / Admin - [Authorize])" {
        usecase "UC10: Đăng nhập / Đăng xuất hệ thống quản trị\n(Cookie Auth / Role: Admin)" as UC_Auth
        usecase "UC11: Quản lý buồng phòng (CRUD RoomType, Room)" as UC_ManageRooms
        usecase "UC12: Quản lý bảng giá linh hoạt (CRUD RatePlan:\nNgày thường / Cuối tuần / Lễ)" as UC_ManageRates
        usecase "UC13: Xử lý nhận phòng (Check-in lúc 14h00)" as UC_CheckIn
        usecase "UC14: Xử lý trả phòng (Check-out lúc 12h00)" as UC_CheckOut
        usecase "UC15: Quản lý danh sách đơn & Xác nhận cọc" as UC_ManageBookings
        usecase "UC16: Xem báo cáo công suất phòng theo tháng" as UC_Reports
        usecase "UC17: AI SmartPaste: Dán tin nhắn Zalo/FB tạo đơn\n(Trích xuất qua IChatClient) [MỞ RỘNG AI]" as UC_SmartPaste
        usecase "UC18: Xác nhận & Hiệu chỉnh thông tin do AI gợi ý\n(Trước khi ghi vào CSDL)" as UC_ConfirmAI
    }
}

' ================= LIÊN KẾT KHÁCH HÀNG =================
Guest --> UC_Search
Guest --> UC_ViewDetail
Guest --> UC_AddToCart
Guest --> UC_Checkout
Guest --> UC_ViewHistory
Guest --> UC_Rule2_Cancel

UC_Checkout ..> UC_Rule1 : <<include>>
UC_Checkout ..> UC_Rule2_Pricing : <<include>>
UC_Checkout ..> UC_Payment : <<include>>
UC_Payment --> Bank : Nhận kết quả thanh toán

' ================= LIÊN KẾT QUẢN TRỊ =================
Host --> UC_Auth
Host --> UC_ManageRooms
Host --> UC_ManageRates
Host --> UC_CheckIn
Host --> UC_CheckOut
Host --> UC_ManageBookings
Host --> UC_Reports
Host --> UC_SmartPaste

UC_SmartPaste ..> UC_ConfirmAI : <<include>>
UC_ConfirmAI ..> UC_Checkout : <<include>>
UC_SmartPaste --> AI : Gọi hàm trích xuất qua IChatClient

UC_CheckIn ..> UC_ManageRooms : Cập nhật phòng: OCCUPIED
UC_CheckOut ..> UC_ManageRooms : Chuyển phòng: CLEANING (12h-14h)

note bottom of UC_Rule1
  <b>Luật 1 (Mục 7 Barem):</b>
  Khách cũ check-out ngày D (12h00)
  thì khách mới check-in ngày D (14h00) hợp lệ.
  Không cho phép 2 khách ở trùng đêm.
end note

note bottom of UC_Rule2_Cancel
  <b>Luật 2 (Mục 7 Barem):</b>
  Tổng tiền = ∑ giá từng đêm (ngày thường / cuối tuần).
  Hủy phòng trước giờ check-in dưới 48 giờ
  bị phạt số tiền tương đương 1 đêm đầu tiên.
end note

@enduml
