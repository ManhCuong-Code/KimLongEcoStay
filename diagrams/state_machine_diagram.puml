@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam roundcorner 8
skinparam shadowing false

skinparam state {
    BackgroundColor #F8F9FA
    BorderColor #6C5CE7
    FontColor #2D3436
    ArrowColor #2D3436
    StartColor #00B894
    EndColor #D63031
}

title SƠ ĐỒ CHUYỂN TRẠNG THÁI (STATE MACHINE DIAGRAM) - DỰ ÁN HOMESTAY HUẾ\nVÒNG ĐỜI ĐƠN ĐẶT (BOOKING) VÀ THỰC THI LUẬT HỦY CỌC 48H (LUẬT 2)

state "VÒNG ĐỜI ĐƠN ĐẶT PHÒNG (BOOKING)" as BookingMachine {
    [*] --> PENDING_DEPOSIT : Khách gửi yêu cầu đặt phòng\n(Giữ chỗ tạm thời 30 phút)

    PENDING_DEPOSIT --> CANCELLED_EXPIRED : Quá 30 phút không nhận được tiền cọc\n(Hệ thống tự động hủy đơn & giải phóng phòng)
    CANCELLED_EXPIRED --> [*]

    PENDING_DEPOSIT --> CONFIRMED : Khách thanh toán cọc 50% qua mã VietQR\n(Khóa lịch buồng phòng trong CSDL)

    CONFIRMED --> CHECKED_IN : Khách đến nhận phòng lúc 14h00\n(Lễ tân bấm nút Check-in)
    
    CHECKED_IN --> CHECKED_OUT : Khách trả phòng lúc 12h00 & thanh toán 50% còn lại\n(Lễ tân bấm nút Check-out)
    CHECKED_OUT --> [*]

    ' Nhánh Hủy phòng theo luật nghiệp vụ 2
    state "KIỂM TRA ĐIỀU KIỆN HỦY (LUẬT 2)" as CancelChoice <<choice>>
    
    CONFIRMED --> CancelChoice : Khách gửi yêu cầu hủy phòng

    CancelChoice --> CANCELLED_FULL_REFUND : [Thời gian hủy >= 48 giờ trước Check-in]\nHoàn lại 100% tiền cọc cho khách
    note right of CANCELLED_FULL_REFUND
      <b>Chính sách linh hoạt:</b>
      Bảo đảm quyền lợi khách hàng
      khi có kế hoạch thay đổi sớm.
    end note

    CancelChoice --> CANCELLED_PENALTY : [Thời gian hủy < 48 giờ trước Check-in]\nKhấu trừ phí phạt tương đương 1 đêm đầu tiên
    note right of CANCELLED_PENALTY
      <b>Bảo vệ chủ homestay (Luật 2):</b>
      Bù đắp chi phí phòng trống
      khi khách hủy gấp sát giờ.
    end note

    CANCELLED_FULL_REFUND --> [*]
    CANCELLED_PENALTY --> [*]
}

state "VÒNG ĐỜI BUỒNG PHÒNG (ROOM)" as RoomMachine {
    [*] --> AVAILABLE : Khởi tạo phòng

    AVAILABLE --> OCCUPIED : Khách nhận phòng (14h00)
    
    OCCUPIED --> CLEANING : Khách trả phòng (12h00)
    
    CLEANING --> AVAILABLE : Dọn dẹp phòng hoàn tất (12h00 - 14h00),\nsẵn sàng cho lượt khách tiếp theo
    
    AVAILABLE --> MAINTENANCE : Thiết bị buồng phòng gặp sự cố
    MAINTENANCE --> AVAILABLE : Bảo trì & kiểm định xong
}

@enduml
